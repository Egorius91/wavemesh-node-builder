+++ b/internal/xray/execution_context_test.go
@@ -0,0 +1,152 @@
+package xray
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	routerService "github.com/xtls/xray-core/app/router/command"
+	"google.golang.org/grpc"
+)
+
+func TestExecutionContextFullHashIsCheckedAtSnapshotAndOwner(t *testing.T) {
+	o := executionFixture(t)
+	before := o.snapshot("")
+	expected := ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch, EffectiveSHA256: strings.Repeat("f", 64)}
+	native, persisted := 0, 0
+	api := persistenceAPI(o, func() error { native++; return nil })
+	if _, err := api.ExecutionRouting(expected); !errors.Is(err, ErrExecutionConflict) {
+		t.Fatal("wrong full hash escaped snapshot fence")
+	}
+	result, err := api.CompareAndApplyRoutingAndPersistContext(context.Background(), executionJSON(fixtureRouting(o, "wm-exit-path-unit")), expected, func() error { persisted++; return nil })
+	after := o.snapshot("")
+	if !errors.Is(err, ErrExecutionConflict) || result != (RoutingPersistenceOutcome{}) || native != 0 || persisted != 0 || !after.Qualified || after.Epoch != before.Epoch || after.EffectiveSHA256 != before.EffectiveSHA256 {
+		t.Fatal("wrong full hash had effects")
+	}
+	expected.EffectiveSHA256 = before.EffectiveSHA256
+	if _, err := api.ExecutionRouting(expected); err != nil {
+		t.Fatal(err)
+	}
+	raw, _ := json.Marshal(expected)
+	if strings.Contains(string(raw), "SHA") || strings.Contains(string(raw), "sha") {
+		t.Fatal("internal field changed legacy DTO")
+	}
+}
+
+func TestExecutionContextCanceledOwnerWaiterHasNoInvalidationOrEffects(t *testing.T) {
+	o := executionFixture(t)
+	before := o.snapshot("")
+	expected := ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch, EffectiveSHA256: before.EffectiveSHA256}
+	data := executionJSON(fixtureRouting(o, "wm-exit-path-unit"))
+	native, persisted := 0, 0
+	api := persistenceAPI(o, func() error { native++; return nil })
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	o.mu.Lock()
+	go func() {
+		_, err := api.CompareAndApplyRoutingAndPersistContext(ctx, data, expected, func() error { persisted++; return nil })
+		done <- err
+	}()
+	select {
+	case <-done:
+		o.mu.Unlock()
+		t.Fatal("operation bypassed owner lock")
+	case <-time.After(20 * time.Millisecond):
+	}
+	cancel()
+	o.mu.Unlock()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled owner waiter returned %v", err)
+	}
+	after := o.snapshot("")
+	if native != 0 || persisted != 0 || !after.Qualified || after.Epoch != before.Epoch || after.EffectiveSHA256 != before.EffectiveSHA256 {
+		t.Fatal("canceled waiter invalidated owner or performed effects")
+	}
+}
+
+func TestExecutionContextCanceledSnapshotWaiterStopsBeforeIdentityInspection(t *testing.T) {
+	o := executionFixture(t)
+	before := o.snapshot("")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	api := &XrayAPI{execution: o}
+	done := make(chan error, 1)
+	inspections := 0
+	o.mu.Lock()
+	o.checkIdentity = func() error { inspections++; return errors.New("synthetic identity drift must not be inspected") }
+	go func() {
+		_, err := api.ExecutionRoutingContext(ctx, ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch, EffectiveSHA256: before.EffectiveSHA256})
+		done <- err
+	}()
+	select {
+	case <-done:
+		o.mu.Unlock()
+		t.Fatal("snapshot bypassed owner lock")
+	case <-time.After(20 * time.Millisecond):
+	}
+	cancel()
+	o.mu.Unlock()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("snapshot cancellation lost: %v", err)
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if inspections != 0 || !o.qualified || o.epoch != 0 {
+		t.Fatal("canceled snapshot inspected identity or invalidated owner")
+	}
+}
+
+type executionContextClient struct {
+	routerService.RoutingServiceClient
+	call func(context.Context) error
+}
+
+func (c executionContextClient) AddRule(ctx context.Context, _ *routerService.AddRuleRequest, _ ...grpc.CallOption) (*routerService.AddRuleResponse, error) {
+	return &routerService.AddRuleResponse{}, c.call(ctx)
+}
+
+func TestExecutionContextNativeSuccessStillPersistsAfterCancellation(t *testing.T) {
+	o := executionFixture(t)
+	before := o.snapshot("")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	native, persisted := 0, 0
+	var client routerService.RoutingServiceClient = executionContextClient{call: func(actual context.Context) error {
+		native++
+		if actual.Done() == nil || actual.Err() != nil {
+			t.Fatal("request context did not reach native RPC")
+		}
+		cancel() // Native has succeeded; losing the response must not skip barriers.
+		if actual.Err() != context.Canceled {
+			t.Fatal("RPC did not share operation cancellation")
+		}
+		return nil
+	}}
+	api := &XrayAPI{execution: o, RoutingServiceClient: &client}
+	result, err := api.CompareAndApplyRoutingAndPersistContext(ctx, executionJSON(fixtureRouting(o, "wm-exit-path-unit")), ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch, EffectiveSHA256: before.EffectiveSHA256}, func() error { persisted++; return nil })
+	if err != nil || native != 1 || persisted != 1 || !result.Persisted || !result.OwnerConfirmed || !o.snapshot("").Qualified || api.operationContext != nil {
+		t.Fatalf("successful effect lost persistence or contaminated legacy API: %+v %v", result, err)
+	}
+}
+
+func TestExecutionContextCanceledNativeOutcomeRemainsUnknown(t *testing.T) {
+	o := executionFixture(t)
+	before := o.snapshot("")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	native, persisted := 0, 0
+	var client routerService.RoutingServiceClient = executionContextClient{call: func(actual context.Context) error {
+		native++
+		cancel()
+		return actual.Err()
+	}}
+	api := &XrayAPI{execution: o, RoutingServiceClient: &client}
+	result, err := api.CompareAndApplyRoutingAndPersistContext(ctx, executionJSON(fixtureRouting(o, "wm-exit-path-unit")), ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch}, func() error { persisted++; return nil })
+	if !errors.Is(err, context.Canceled) || native != 1 || persisted != 0 || !result.NativeAttempted || result.NativeSucceeded || result.OwnerConfirmed || o.snapshot("").Qualified {
+		t.Fatal("ambiguous native cancellation was replayed or accepted")
+	}
+}
