+	"github.com/mhsanaei/3x-ui/v3/internal/util/crypto"
+	"github.com/mhsanaei/3x-ui/v3/internal/web/service"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+func executionRequestFixture() map[string]any {
+	return map[string]any{"schema_version": 1, "transaction_id": "20261117T154000Z-unit", "intent_sha256": strings.Repeat("a", 64),
+		"expected":        map[string]any{"generation": "00000000-0000-4000-8000-000000000002", "epoch": "0", "effective_config_sha256": strings.Repeat("b", 64)},
+		"template_before": "{\n  \"sentinel\": \"exact raw template\"\n}\n", "rule_tag": "wm-rule-unit", "target": "wm-exit-path-unit"}
+}
+
+func executionRequestBytes(value any) string { raw, _ := json.Marshal(value); return string(raw) }
+
+func TestExecutionSelectorStrictBoundaryRejectsBeforeApply(t *testing.T) {
+	t.Setenv("XUI_PREPARED_ATTESTATION", "1")
+	valid := executionRequestBytes(executionRequestFixture())
+	cases := map[string]string{
+		"duplicate":         strings.Replace(valid, `"schema_version":1`, `"schema_version":1,"schema_version":1`, 1),
+		"escaped duplicate": strings.Replace(valid, `"schema_version":1`, `"schema_version":1,"schema_\u0076ersion":1`, 1),
+		"trailing":          valid + `{}`, "array": `[]`, "invalid utf8": valid[:len(valid)-1] + string([]byte{255}) + `}`,
+		"oversized": strings.Repeat(" ", executionRequestLimit+1) + valid,
+	}
+	for _, change := range []string{"unknown", "missing", "case-folded", "null-version", "float-version", "bool-version", "empty-transaction", "wrong-hash", "uuid-case", "epoch-leading-zero", "epoch-overflow", "epoch-last", "expected-unknown", "expected-duplicate", "template-duplicate", "template-trailing", "target-direct", "empty-rule", "deep-template"} {
+		value := executionRequestFixture()
+		expected := value["expected"].(map[string]any)
+		switch change {
+		case "unknown":
+			value["verified"] = true
+		case "missing":
+			delete(value, "intent_sha256")
+		case "case-folded":
+			value["Schema_Version"] = value["schema_version"]
+			delete(value, "schema_version")
+		case "null-version":
+			value["schema_version"] = nil
+		case "float-version":
+			cases[change] = strings.Replace(valid, `"schema_version":1`, `"schema_version":1.0`, 1)
+			continue
+		case "bool-version":
+			value["schema_version"] = true
+		case "empty-transaction":
+			value["transaction_id"] = ""
+		case "wrong-hash":
+			expected["effective_config_sha256"] = strings.Repeat("B", 64)
+		case "uuid-case":
+			expected["generation"] = "00000000-0000-4000-8000-00000000000A"
+		case "epoch-leading-zero":
+			expected["epoch"] = "00"
+		case "epoch-overflow":
+			expected["epoch"] = "18446744073709551616"
+		case "epoch-last":
+			expected["epoch"] = "18446744073709551615"
+		case "expected-unknown":
+			expected["verified"] = true
+		case "expected-duplicate":
+			cases[change] = strings.Replace(valid, `"epoch":"0"`, `"epoch":"0","epoch":"0"`, 1)
+			continue
+		case "template-duplicate":
+			value["template_before"] = `{"x":1,"x":2}`
+		case "template-trailing":
+			value["template_before"] = `{} {}`
+		case "target-direct":
+			value["target"] = "direct"
+		case "empty-rule":
+			value["rule_tag"] = "wm-rule-"
+		case "deep-template":
+			value["template_before"] = `{"x":` + strings.Repeat("[", 34) + `0` + strings.Repeat("]", 34) + `}`
+		}
+		cases[change] = executionRequestBytes(value)
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			engine := gin.New()
+			calls := 0
+			engine.POST("/", func(c *gin.Context) {
+				serveExecutionSelector(c, func(context.Context, xray.ExecutionExpected, string, string, string) (service.ExecutionPersistenceResult, error) {
+					calls++
+					return service.ExecutionPersistenceResult{}, nil
+				})
+			})
+			req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body))
+			req.Header.Set("Content-Type", "application/json")
+			w := httptest.NewRecorder()
+			engine.ServeHTTP(w, req)
+			if calls != 0 || w.Code != 400 || strings.Contains(w.Body.String(), "outcome") {
+				t.Fatalf("invalid body reached apply or fabricated receipt: %d %d", calls, w.Code)
+			}
+		})
+	}
+}
+
+func TestExecutionSelectorRetainsBoundPartialOutcomeWithFixedDiagnostic(t *testing.T) {
+	t.Setenv("XUI_PREPARED_ATTESTATION", "1")
+	engine := gin.New()
+	calls := 0
+	engine.POST("/", func(c *gin.Context) {
+		serveExecutionSelector(c, func(ctx context.Context, expected xray.ExecutionExpected, template, rule, target string) (service.ExecutionPersistenceResult, error) {
+			calls++
+			if expected.EffectiveSHA256 != strings.Repeat("b", 64) || template != executionRequestFixture()["template_before"] || rule != "wm-rule-unit" || target != "wm-exit-path-unit" || ctx == nil {
+				t.Fatal("request binding lost")
+			}
+			return service.ExecutionPersistenceResult{NativeAttempted: true, NativeSucceeded: true, TemplatePersisted: true}, errors.New("private-error-template-credential")
+		})
+	})
+	req := httptest.NewRequest("POST", "/", strings.NewReader(executionRequestBytes(executionRequestFixture())))
+	req.Header.Set("Content-Type", "application/json")
+	w := httptest.NewRecorder()
+	engine.ServeHTTP(w, req)
+	var reply map[string]json.RawMessage
+	if json.Unmarshal(w.Body.Bytes(), &reply) != nil || len(reply) != 4 || calls != 1 || w.Code != 409 || w.Header().Get(executionDiagnosticHeader) != "OUTCOME_UNPROVEN" || strings.Contains(w.Body.String(), "private-error") || !strings.Contains(string(reply["outcome"]), `"TemplatePersisted":true`) {
+		t.Fatal("partial operation receipt lost or leaked data")
+	}
+}
+
+func TestExecutionSelectorDisabledOrCanceledRequestNeverCallsService(t *testing.T) {
+	for _, disabled := range []bool{true, false} {
+		t.Run(map[bool]string{true: "disabled", false: "canceled"}[disabled], func(t *testing.T) {
+			t.Setenv("XUI_PREPARED_ATTESTATION", map[bool]string{true: "0", false: "1"}[disabled])
+			engine := gin.New()
+			engine.POST("/", func(c *gin.Context) {
+				serveExecutionSelector(c, func(context.Context, xray.ExecutionExpected, string, string, string) (service.ExecutionPersistenceResult, error) {
+					t.Fatal("rejected context reached service")
+					return service.ExecutionPersistenceResult{}, nil
+				})
+			})
+			req := httptest.NewRequest("POST", "/", strings.NewReader(executionRequestBytes(executionRequestFixture())))
+			req.Header.Set("Content-Type", "application/json")
+			if !disabled {
+				ctx, cancel := context.WithCancel(req.Context())
+				cancel()
+				req = req.WithContext(ctx)
+			}
+			w := httptest.NewRecorder()
+			engine.ServeHTTP(w, req)
+			if strings.Contains(w.Body.String(), "outcome") || w.Code < 400 {
+				t.Fatal("rejection fabricated owner result")
+			}
+		})
+	}
+}
+
+func TestExecutionSelectorExistingAuthScopesAndSession(t *testing.T) {
+	t.Setenv("XUI_PREPARED_ATTESTATION", "1")
+	engine, a := newAPIAuthTestEngine(t)
+	calls := 0
+	api := engine.Group("/panel/api")
+	api.Use(a.checkAPIAuth)
+	api.Use(a.enforceTokenScope)
+	api.POST("/xray/executionSelector", func(c *gin.Context) {
+		serveExecutionSelector(c, func(context.Context, xray.ExecutionExpected, string, string, string) (service.ExecutionPersistenceResult, error) {
+			calls++
+			return service.ExecutionPersistenceResult{NoOp: true}, nil
+		})
+	})
+	for _, scope := range []string{model.ApiScopeAdmin, model.ApiScopeNodeSync, model.ApiScopeNodeAdmin, model.ApiScopeMonitor} {
+		plain := "synthetic-execution-" + scope
+		if err := database.GetDB().Create(&model.ApiToken{Name: scope, Token: crypto.HashTokenSHA256(plain), Enabled: true, Scope: scope}).Error; err != nil {
+			t.Fatal(err)
+		}
+		for _, mtls := range []bool{false, true} {
+			before := calls
+			req := httptest.NewRequest("POST", "/panel/api/xray/executionSelector", strings.NewReader(executionRequestBytes(executionRequestFixture())))
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("Authorization", "Bearer "+plain)
+			if mtls {
+				req.TLS = &tls.ConnectionState{VerifiedChains: [][]*x509.Certificate{{{}}}}
+			}
+			w := httptest.NewRecorder()
+			engine.ServeHTTP(w, req)
+			allowed := scope == model.ApiScopeAdmin && !mtls
+			if allowed && (w.Code != 200 || calls != before+1) || !allowed && (w.Code != 403 || calls != before) {
+				t.Fatalf("scope boundary changed: %s mtls=%v code=%d", scope, mtls, w.Code)
+			}
+		}
+	}
+	login := httptest.NewRecorder()
+	engine.ServeHTTP(login, httptest.NewRequest("GET", "/test-login", nil))
+	req := httptest.NewRequest("POST", "/panel/api/xray/executionSelector", strings.NewReader(executionRequestBytes(executionRequestFixture())))
+	req.Header.Set("Content-Type", "application/json")
+	for _, cookie := range login.Result().Cookies() {
+		req.AddCookie(cookie)
+	}
+	before := calls
+	w := httptest.NewRecorder()
+	engine.ServeHTTP(w, req)
+	if w.Code != 200 || calls != before+1 {
+		t.Fatal("existing authenticated session lost authority")
+	}
+}
