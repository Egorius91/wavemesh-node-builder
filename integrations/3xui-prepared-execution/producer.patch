+	for _, raw := range []string{`{"schema_version":3,"schema_version":3,"challenge":"` + nonce + `"}`, strings.Replace(good, "3", "true", 1), strings.Replace(good, nonce, strings.ToUpper(nonce), 1), good + `{}`, `{"schema_version":3,"challenge":"` + nonce + `","path":"/tmp/other"}`, strings.Repeat(" ", 257) + good} {
+		if _, err := parseExecutionChallenge([]byte(raw)); err == nil || err.Error() != "invalid private snapshot request" {
