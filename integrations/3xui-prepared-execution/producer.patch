+	if !errors.Is(err, ErrExecutionConflict) || called || o.epoch != 2 || !o.qualified {
+		t.Fatalf("stale CAS had effects: err=%v called=%v epoch=%d qualified=%v", err, called, o.epoch, o.qualified)
+	}
+}
