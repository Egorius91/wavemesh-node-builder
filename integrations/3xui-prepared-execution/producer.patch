+const stockCoreSHA256 = "a27e3f95ab6ce270956d0cecd32eda4686a811afc71c64a6a734a3dede14883e"
+const producerUpstream = "c621ba9014a6aa21fd7c9ecf45655e44e24ebf13"
+
+var ErrExecutionConflict = errors.New("execution generation or epoch conflict")
+var ErrExecutionSelector = errors.New("unsupported execution selector transition")
+var ErrExecutionControlBoundary = errors.New("unsupported native control boundary")
+
+type ExecutionIdentity struct {
+	Generation         string `json:"generation"`
+	BootID             string `json:"boot_id"`
+	PID                int    `json:"pid"`
+	StartTicks         string `json:"start_ticks"`
+	CoreSHA256         string `json:"core_sha256"`
+	ProducerPID        int    `json:"producer_pid"`
+	ProducerStartTicks string `json:"producer_start_ticks"`
+	ProducerSHA256     string `json:"producer_sha256"`
+	ProducerUpstream   string `json:"producer_upstream"`
+	ConsumedSHA256     string `json:"consumed_sha256"`
+}
+
+type ExecutionExpected struct {
+	Generation string `json:"generation"`
+	Epoch      string `json:"epoch"`
+}
+
+type SelectorTransition struct {
+	Generation       string `json:"generation"`
+	FromEpoch        string `json:"from_epoch"`
+	ToEpoch          string `json:"to_epoch"`
+	BeforeSHA256     string `json:"before_sha256"`
+	AfterSHA256      string `json:"after_sha256"`
+	NormalizedSHA256 string `json:"normalized_sha256"`
+	RuleTag          string `json:"rule_tag"`
+}
+
+type ExecutionSnapshot struct {
+	SchemaVersion   int                 `json:"schema_version"`
+	Challenge       string              `json:"challenge"`
+	Qualified       bool                `json:"qualified"`
+	Reason          string              `json:"reason"`
+	Identity        ExecutionIdentity   `json:"identity"`
+	Epoch           string              `json:"epoch"`
+	EffectiveSHA256 string              `json:"effective_config_sha256,omitempty"`
+	ExecutionSHA256 string              `json:"execution_sha256,omitempty"`
+	Config          json.RawMessage     `json:"effective_config,omitempty"`
+	Overrides       map[string]string   `json:"balancer_overrides,omitempty"`
+	Transition      *SelectorTransition `json:"selector_transition,omitempty"`
+}
+
+type executionOwner struct {
+	mu             sync.Mutex
+	peerPID        atomic.Int64
+	peerStartTicks atomic.Value
+	identity       ExecutionIdentity
+	epoch          uint64
+	qualified      bool
+	reason         string
+	config         map[string]any
+	overrides      map[string]string
+	transition     *SelectorTransition
+	checkIdentity  func() error
+	executable     *os.File
+}
+
+func executionJSON(v any) []byte {
+	var b bytes.Buffer
+	e := json.NewEncoder(&b)
+	e.SetEscapeHTML(false)
+	if err := e.Encode(v); err != nil {
+		return nil
+	}
+	return bytes.TrimSuffix(b.Bytes(), []byte{'\n'})
+}
+
+func executionDigest(v any) string {
+	h := sha256.Sum256(executionJSON(v))
+	return hex.EncodeToString(h[:])
+}
+
+func executionDocument(data []byte) (map[string]any, error) {
+	var v map[string]any
+	d := json.NewDecoder(bytes.NewReader(data))
+	d.UseNumber()
+	if err := d.Decode(&v); err != nil || v == nil {
+		return nil, errors.New("invalid execution document")
+	}
+	return v, nil
+}
+
+func newExecutionOwner(data []byte, id ExecutionIdentity, check func() error) *executionOwner {
+	v, _ := executionDocument(data)
+	return &executionOwner{identity: id, config: v, overrides: map[string]string{}, reason: "cold_start_unqualified", checkIdentity: check}
+}
+
+func (o *executionOwner) invalidate(reason string) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.invalidateLocked(reason)
+}
+
+func (o *executionOwner) closeIdentity(reason string) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.invalidateLocked(reason)
+	if o.executable != nil {
+		_ = o.executable.Close()
+		o.executable = nil
+	}
+}
+
+func (o *executionOwner) invalidateLocked(reason string) {
+	if o.epoch < ^uint64(0) {
+		o.epoch++
+	} else {
+		reason = "epoch_exhausted"
+	}
+	o.qualified = false
+	o.reason = reason
+	o.transition = nil
+}
+
+func (o *executionOwner) identityValidLocked() bool {
+	if o.checkIdentity != nil && o.checkIdentity() != nil {
+		o.invalidateLocked("process_identity_changed")
+		return false
+	}
+	return true
+}
+
+func (o *executionOwner) snapshot(challenge string) ExecutionSnapshot {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.identityValidLocked()
+	s := ExecutionSnapshot{SchemaVersion: executionSchema, Challenge: challenge, Qualified: o.qualified, Reason: o.reason, Identity: o.identity, Epoch: strconv.FormatUint(o.epoch, 10)}
+	if o.qualified {
+		s.Config = executionJSON(o.config)
+		s.EffectiveSHA256 = executionDigest(o.config)
+		s.ExecutionSHA256 = executionDigest(map[string]any{"effective_config": o.config, "balancer_overrides": o.overrides})
+		s.Overrides = make(map[string]string, len(o.overrides))
+		for k, v := range o.overrides {
+			s.Overrides[k] = v
+		}
+		if o.transition != nil {
+			r := *o.transition
+			s.Transition = &r
+		}
+	}
+	return s
+}
+
+func (o *executionOwner) mutate(kind string, payload map[string]any, expected *ExecutionExpected, call func() error) error {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	valid := o.identityValidLocked()
+	if !valid {
+		return ErrExecutionConflict
+	}
+	if o.epoch == ^uint64(0) {
+		o.qualified = false
+		o.reason = "epoch_exhausted"
+		o.transition = nil
+	}
+	if expected != nil && (!valid || !o.qualified || expected.Generation != o.identity.Generation || expected.Epoch != strconv.FormatUint(o.epoch, 10)) {
+		return ErrExecutionConflict
+	}
+	if expected != nil {
+		routing, ok := payload["routing"].(map[string]any)
+		old, ok2 := o.config["routing"].(map[string]any)
+		if kind != "ApplyRoutingConfig" || !ok || !ok2 {
+			return ErrExecutionSelector
+		}
+		if executionDigest(old) == executionDigest(routing) {
+			return nil
+		}
+		if tag, _ := selectorOnlyTransition(old, routing, o.config); tag == "" {
+			return ErrExecutionSelector
+		}
+	}
+	if err := o.validateControlMutation(kind, payload); err != nil {
+		return err
+	}
+	wasQualified := o.qualified
+	beforeEpoch, beforeDigest := o.epoch, executionDigest(o.config)
+	o.invalidateLocked("native_outcome_unknown")
+	if err := call(); err != nil {
+		return err
+	}
+	if !wasQualified {
+		return nil
+	}
+	next, err := executionDocument(executionJSON(o.config))
+	if err != nil {
+		o.reason = "unsupported_native_effect"
+		return nil
+	}
+	nextOverrides := make(map[string]string, len(o.overrides))
+	for tag, target := range o.overrides {
+		nextOverrides[tag] = target
+	}
+	rule, normalized, err := applyExecutionEffect(next, nextOverrides, kind, payload)
+	if err != nil {
+		o.reason = "unsupported_native_effect"
+		return nil
+	}
+	if err := validateExecutionInputs(next); err != nil {
+		o.reason = "unsupported_execution_input"
+		return nil
+	}
+	if err := validateExecutionOverrides(next, nextOverrides); err != nil {
+		o.reason = "unsupported_native_control_state"
+		return nil
+	}
+	if !o.identityValidLocked() {
+		return nil
+	}
+	o.config, o.overrides, o.qualified, o.reason = next, nextOverrides, true, "custody_attested"
+	if rule != "" {
+		o.transition = &SelectorTransition{Generation: o.identity.Generation, FromEpoch: strconv.FormatUint(beforeEpoch, 10), ToEpoch: strconv.FormatUint(o.epoch, 10), BeforeSHA256: beforeDigest, AfterSHA256: executionDigest(next), NormalizedSHA256: normalized, RuleTag: rule}
+	}
+	return nil
+}
+
+func taggedObjects(document map[string]any, key string) ([]any, error) {
+	v, ok := document[key].([]any)
+	if !ok {
+		return nil, fmt.Errorf("missing %s", key)
+	}
+	return v, nil
+}
+
+func uniqueTag(items []any, tag string) (int, error) {
+	idx := -1
+	for i, v := range items {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return -1, errors.New("invalid tagged object")
+		}
+		if m["tag"] == tag {
+			if idx >= 0 {
+				return -1, errors.New("duplicate tag")
+			}
+			idx = i
+		}
+	}
+	return idx, nil
+}
+
+func applyExecutionEffect(doc map[string]any, overrides map[string]string, kind string, payload map[string]any) (string, string, error) {
+	unsupported := errors.New("unsupported native effect")
+	switch kind {
+	case "AddInbound", "AddOutbound", "DelInbound", "DelOutbound":
+		key := "inbounds"
+		if strings.HasSuffix(kind, "Outbound") {
+			key = "outbounds"
+		}
+		items, err := taggedObjects(doc, key)
+		if err != nil {
+			return "", "", err
+		}
+		var object map[string]any
+		if strings.HasPrefix(kind, "Add") {
+			object, _ = payload["object"].(map[string]any)
+			if object == nil {
+				return "", "", unsupported
+			}
+		}
+		tag, _ := payload["tag"].(string)
+		if object != nil {
+			tag, _ = object["tag"].(string)
+		}
+		if tag == "" || tag == "api" {
+			return "", "", unsupported
+		}
+		i, err := uniqueTag(items, tag)
+		if err != nil {
+			return "", "", err
+		}
+		if object != nil {
+			if i >= 0 {
+				return "", "", unsupported
+			}
+			items = append(items, object)
+		} else {
+			if i < 0 {
+				return "", "", unsupported
+			}
+			items = append(items[:i], items[i+1:]...)
+		}
+		doc[key] = items
+	case "AddUser", "RemoveUser":
+		items, err := taggedObjects(doc, "inbounds")
+		if err != nil {
+			return "", "", err
+		}
+		tag, _ := payload["tag"].(string)
+		i, err := uniqueTag(items, tag)
+		if err != nil || i < 0 {
+			return "", "", unsupported
+		}
+		ib := items[i].(map[string]any)
+		if ib["protocol"] != "vless" || (kind == "AddUser" && payload["protocol"] != "vless") {
+			return "", "", unsupported
+		}
+		settings, ok := ib["settings"].(map[string]any)
+		if !ok {
+			return "", "", unsupported
+		}
+		clients, ok := settings["clients"].([]any)
+		if !ok {
+			return "", "", unsupported
+		}
+		email, _ := payload["email"].(string)
+		user, _ := payload["user"].(map[string]any)
+		if kind == "AddUser" {
+			if user == nil {
+				return "", "", unsupported
+			}
+			email, _ = user["email"].(string)
+			for k := range user {
+				if k != "email" && k != "id" && k != "flow" {
+					return "", "", unsupported
+				}
+			}
+			if _, ok := user["id"].(string); !ok {
+				return "", "", unsupported
+			}
+		}
+		if email == "" {
+			return "", "", unsupported
+		}
+		found := -1
+		for j, c := range clients {
+			m, ok := c.(map[string]any)
+			if !ok {
+				return "", "", unsupported
+			}
+			if m["email"] == email {
+				if found >= 0 {
+					return "", "", unsupported
+				}
+				found = j
+			}
+		}
+		if kind == "AddUser" {
+			if found >= 0 {
+				return "", "", unsupported
+			}
+			clients = append(clients, user)
+		} else {
+			if found < 0 {
+				return "", "", unsupported
+			}
+			clients = append(clients[:found], clients[found+1:]...)
+		}
+		settings["clients"] = clients
+	case "SetBalancerTarget":
+		tag, ok := payload["tag"].(string)
+		target, ok2 := payload["target"].(string)
+		if !ok || !ok2 {
+			return "", "", unsupported
+		}
+		if err := validateBalancerOverride(doc, tag, target); err != nil {
+			return "", "", err
+		}
+		if target == "" {
+			delete(overrides, tag)
+		} else {
+			overrides[tag] = target
+		}
+	case "ApplyRoutingConfig":
+		next, ok := payload["routing"].(map[string]any)
+		old, ok2 := doc["routing"].(map[string]any)
+		if !ok || !ok2 {
+			return "", "", unsupported
+		}
+		for _, key := range []string{"domainStrategy", "domainMatcher", "script"} {
+			if executionDigest(old[key]) != executionDigest(next[key]) {
+				return "", "", unsupported
+			}
+		}
+		// Routing reload resets balancers; unknown override semantics cannot be resealed.
+		if len(overrides) != 0 {
+			return "", "", unsupported
+		}
+		tag, normalized := selectorOnlyTransition(old, next, doc)
+		doc["routing"] = next
+		return tag, normalized, nil
+	default:
+		return "", "", unsupported
+	}
+	return "", "", nil
+}
+
+func selectorOnlyTransition(old, next, doc map[string]any) (string, string) {
+	a, _ := executionDocument(executionJSON(old))
+	b, _ := executionDocument(executionJSON(next))
+	x, ok := a["rules"].([]any)
+	y, ok2 := b["rules"].([]any)
+	if !ok || !ok2 || len(x) != len(y) {
+		return "", ""
+	}
+	changed := ""
+	for i, v := range x {
+		if executionDigest(v) == executionDigest(y[i]) {
+			continue
+		}
+		r, ok := v.(map[string]any)
+		s, ok2 := y[i].(map[string]any)
+		if !ok || !ok2 || changed != "" || len(r) != 4 || len(s) != 4 {
+			return "", ""
+		}
+		tag, _ := r["ruleTag"].(string)
+		if !strings.HasPrefix(tag, "wm-rule-") || r["type"] != "field" || s["type"] != "field" {
+			return "", ""
+		}
+		in, ok := r["inboundTag"].([]any)
+		if !ok || len(in) != 1 {
+			return "", ""
+		}
+		inbound, ok := in[0].(string)
+		if !ok || !strings.HasPrefix(inbound, "wm-route-") {
+			return "", ""
+		}
+		for _, rule := range []map[string]any{r, s} {
+			target, ok := rule["outboundTag"].(string)
+			if !ok || (target != "wm-eu-only-block" && !strings.HasPrefix(target, "wm-exit-path-")) {
+				return "", ""
+			}
+			outbounds, err := taggedObjects(doc, "outbounds")
+			if err != nil {
+				return "", ""
+			}
+			idx, err := uniqueTag(outbounds, target)
+			if err != nil || idx < 0 {
+				return "", ""
+			}
+		}
+		if _, ok := r["outboundTag"].(string); !ok {
+			return "", ""
+		}
+		if _, ok := s["outboundTag"].(string); !ok {
+			return "", ""
+		}
+		r["outboundTag"], s["outboundTag"] = "wm-eu-only-block", "wm-eu-only-block"
+		if executionDigest(r) != executionDigest(s) {
+			return "", ""
+		}
+		changed = tag
+	}
+	if changed == "" || executionDigest(a) != executionDigest(b) {
+		return "", ""
+	}
+	normalized, _ := executionDocument(executionJSON(doc))
+	normalized["routing"] = a
+	return changed, executionDigest(normalized)
+}
+
+type executionCallKey struct{}
+
+func (o *executionOwner) intercept(ctx context.Context, method string, req, reply any, cc *grpc.ClientConn, invoke grpc.UnaryInvoker, opts ...grpc.CallOption) error {
+	if ctx.Value(executionCallKey{}) == o || executionReadMethod(method) {
+		return invoke(ctx, method, req, reply, cc, opts...)
+	}
+	return o.mutate("UnaccountedRPC", nil, nil, func() error { return invoke(ctx, method, req, reply, cc, opts...) })
+}
+
+func executionReadMethod(method string) bool {
+	switch method {
+	case "/xray.app.stats.command.StatsService/GetStats", "/xray.app.stats.command.StatsService/QueryStats", "/xray.app.stats.command.StatsService/GetSysStats", "/xray.app.stats.command.StatsService/GetStatsOnline", "/xray.app.stats.command.StatsService/GetStatsOnlineIpList", "/xray.app.stats.command.StatsService/GetUsersStats", "/xray.app.stats.command.StatsService/GetAllOnlineUsers", "/xray.app.router.command.RoutingService/GetBalancerInfo", "/xray.app.router.command.RoutingService/TestRoute", "/xray.app.router.command.RoutingService/ListRule", "/xray.app.proxyman.command.HandlerService/ListInbounds", "/xray.app.proxyman.command.HandlerService/ListOutbounds":
+		return true
+	}
+	return false
+}
+
+func validateExecutionInputs(doc map[string]any) error {
+	// Referenced files, scripts and environment expansion escape immutable-input custody.
+	var visit func(any) error
+	visit = func(v any) error {
+		switch x := v.(type) {
+		case map[string]any:
+			for k, y := range x {
+				if k == "listen" && x["tag"] == "api" && y == executionCorePath+",0600" {
+					continue
+				}
+				lower := strings.ToLower(k)
+				if strings.Contains(lower, "file") || lower == "script" || lower == "env" || lower == "geodata" || lower == "reverse" || lower == "transport" || lower == "noises" {
+					if y != nil {
+						return errors.New("unsupported external execution input")
+					}
+				}
+				if err := visit(y); err != nil {
+					return err
+				}
+			}
+		case []any:
+			for _, y := range x {
+				if err := visit(y); err != nil {
+					return err
+				}
+			}
+		case string:
+			if strings.Contains(x, "/run/wavemesh-xray") || strings.ContainsAny(x, "\u2028\u2029") || strings.Contains(x, "${") || strings.HasPrefix(x, "ext:") || strings.HasPrefix(x, "geoip:") || strings.HasPrefix(x, "geosite:") {
+				return errors.New("unsupported external execution input")
+			}
+		case json.Number:
+			if len(x) > 20 || x == "-0" || strings.ContainsAny(string(x), ".eE") {
+				return errors.New("unsupported fractional execution input")
+			}
+		}
+		return nil
+	}
+	if err := visit(doc); err != nil {
+		return err
+	}
+	ibs, err := taggedObjects(doc, "inbounds")
+	if err != nil {
+		return err
+	}
+	for _, v := range ibs {
+		ib, ok := v.(map[string]any)
+		if !ok {
+			return errors.New("unsupported inbound")
+		}
+		if ib["tag"] == "api" {
+			if ib["protocol"] != "dokodemo-door" && ib["protocol"] != "tunnel" {
+				return errors.New("unsupported API inbound")
+			}
+			continue
+		}
+		stream, ok := ib["streamSettings"].(map[string]any)
+		if ib["protocol"] != "vless" || !ok || stream["network"] != "xhttp" || stream["security"] != "tls" {
+			return errors.New("unsupported managed ingress")
+		}
+		xhttp, ok := stream["xhttpSettings"].(map[string]any)
+		if !ok || xhttp["mode"] != "stream-one" {
+			return errors.New("unsupported managed transport")
+		}
+	}
+	return validateNativeControlBoundary(doc)
+}
+
+func validateNativeControlBoundary(doc map[string]any) error {
+	bad := ErrExecutionControlBoundary
+	api, ok := doc["api"].(map[string]any)
+	if !ok || len(api) != 2 || api["tag"] != "api" {
+		return bad
+	}
+	services, ok := api["services"].([]any)
+	if !ok {
+		return bad
+	}
+	seenServices := map[string]bool{}
+	for _, v := range services {
+		s, ok := v.(string)
+		if !ok || seenServices[s] {
+			return bad
+		}
+		switch s {
+		case "HandlerService", "RoutingService", "StatsService", "LoggerService":
+		default:
+			return bad
+		}
+		seenServices[s] = true
+	}
+	if !seenServices["HandlerService"] || !seenServices["RoutingService"] || !seenServices["StatsService"] {
+		return bad
+	}
+	for _, key := range []string{"inbounds", "outbounds"} {
+		objects, err := taggedObjects(doc, key)
+		if err != nil {
+			return bad
+		}
+		seen := map[string]bool{}
+		for _, v := range objects {
+			m, ok := v.(map[string]any)
+			if !ok {
+				return bad
+			}
+			tag, ok := m["tag"].(string)
+			if !ok || tag == "" || seen[tag] {
+				return bad
+			}
+			seen[tag] = true
+			if key == "outbounds" && tag == "api" {
+				return bad
+			}
+			if tag != "api" && referencesNativeControl(m) {
+				return bad
+			}
+		}
+		if key == "inbounds" && !seen["api"] {
+			return bad
+		}
+	}
+	routing, ok := doc["routing"].(map[string]any)
+	if !ok {
+		return bad
+	}
+	rules, ok := routing["rules"].([]any)
+	if !ok {
+		return bad
+	}
+	apiRules := 0
+	for _, v := range rules {
+		r, ok := v.(map[string]any)
+		if !ok {
+			return bad
+		}
+		if r["outboundTag"] == "api" {
+			in, ok := r["inboundTag"].([]any)
+			if !ok || len(in) != 1 || in[0] != "api" || r["type"] != "field" || len(r) != 3 {
+				return bad
+			}
+			apiRules++
+		}
+	}
+	if apiRules != 1 {
+		return bad
+	}
+	if balancers, ok := routing["balancers"].([]any); ok {
+		for _, v := range balancers {
+			b, ok := v.(map[string]any)
+			if !ok {
+				return bad
+			}
+			if referencesNativeControl(b) {
+				return bad
+			}
+			selectors, ok := b["selector"].([]any)
+			if !ok {
+				return bad
+			}
+			for _, v := range selectors {
+				prefix, ok := v.(string)
+				if !ok || strings.HasPrefix("api", prefix) {
+					return bad
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func referencesNativeControl(value any) bool {
+	switch v := value.(type) {
+	case map[string]any:
+		for key, item := range v {
+			if item == "api" && (key == "tag" || key == "inboundTag" || key == "outboundTag" || key == "dialerProxy" || key == "fallbackTag") {
+				return true
+			}
+			if referencesNativeControl(item) {
+				return true
+			}
+		}
+	case []any:
+		for _, item := range v {
+			if referencesNativeControl(item) {
+				return true
+			}
+		}
+	case string:
+		return strings.Contains(v, "/run/wavemesh-xray")
+	}
+	return false
+}
+
+func validateBalancerOverride(doc map[string]any, tag, target string) error {
+	bad := ErrExecutionControlBoundary
+	routing, ok := doc["routing"].(map[string]any)
+	if !ok || tag == "" {
+		return bad
+	}
+	balancers, ok := routing["balancers"].([]any)
+	if !ok {
+		return bad
+	}
+	if index, err := uniqueTag(balancers, tag); err != nil || index < 0 {
+		return bad
+	}
+	if target == "" {
+		return nil
+	}
+	if target == "api" {
+		return bad
+	}
+	outbounds, err := taggedObjects(doc, "outbounds")
+	if err != nil {
+		return bad
+	}
+	index, err := uniqueTag(outbounds, target)
+	if err != nil || index < 0 || referencesNativeControl(outbounds[index]) {
+		return bad
+	}
+	return nil
+}
+
+func validateExecutionOverrides(doc map[string]any, overrides map[string]string) error {
+	for tag, target := range overrides {
+		if target == "" {
+			return ErrExecutionControlBoundary
+		}
+		if err := validateBalancerOverride(doc, tag, target); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (o *executionOwner) validateControlMutation(kind string, payload map[string]any) error {
+	switch kind {
+	case "SetBalancerTarget":
+		tag, ok := payload["tag"].(string)
+		target, targetOK := payload["target"].(string)
+		if !ok || !targetOK {
+			return ErrExecutionControlBoundary
+		}
+		if err := validateBalancerOverride(o.config, tag, target); err != nil {
+			return err
+		}
+		if !o.qualified && target != "" {
+			return ErrExecutionConflict
+		}
+	case "ApplyRoutingConfig":
+		routing, ok := payload["routing"].(map[string]any)
+		if !ok {
+			return nil
+		}
+		next, err := executionDocument(executionJSON(o.config))
+		if err != nil {
+			return ErrExecutionControlBoundary
+		}
+		next["routing"] = routing
+		return validateNativeControlBoundary(next)
+	case "AddInbound", "AddOutbound":
+		object, _ := payload["object"].(map[string]any)
+		if object["tag"] == "api" || referencesNativeControl(object) {
+			return ErrExecutionControlBoundary
+		}
+	case "DelInbound", "DelOutbound":
+		if payload["tag"] == "api" {
+			return ErrExecutionControlBoundary
+		}
+	}
+	return nil
+}
+
+func initializePreparedDeny(doc map[string]any) error {
+	routing, ok := doc["routing"].(map[string]any)
+	if !ok {
+		return errors.New("routing missing")
+	}
+	rules, ok := routing["rules"].([]any)
+	if !ok {
+		return errors.New("routing rules missing")
+	}
+	for _, v := range rules {
+		r, ok := v.(map[string]any)
+		if !ok {
+			return errors.New("invalid routing rule")
+		}
+		tag, _ := r["ruleTag"].(string)
+		target, _ := r["outboundTag"].(string)
+		if !strings.HasPrefix(tag, "wm-rule-") || (target != "wm-eu-only-block" && !strings.HasPrefix(target, "wm-exit-path-")) {
+			continue
+		}
+		in, ok := r["inboundTag"].([]any)
+		if !ok || len(in) != 1 || r["type"] != "field" || len(r) != 4 {
+			return errors.New("prepared rule is not unconditional")
+		}
+		inbound, ok := in[0].(string)
+		if !ok || !strings.HasPrefix(inbound, "wm-route-") {
+			return errors.New("prepared rule inbound is unsupported")
+		}
+		outbounds, err := taggedObjects(doc, "outbounds")
+		if err != nil {
+			return err
+		}
+		idx, err := uniqueTag(outbounds, "wm-eu-only-block")
+		if err != nil || idx < 0 || outbounds[idx].(map[string]any)["protocol"] != "blackhole" {
+			return errors.New("prepared deny outbound missing")
+		}
+		r["outboundTag"] = "wm-eu-only-block"
+	}
+	return nil
+}
+
+func (p *process) invalidateExecution(reason string) {
+	p.mu.RLock()
+	o := p.execution
+	p.mu.RUnlock()
+	if o != nil {
+		o.invalidate(reason)
+	}
+}
+func (p *Process) InvalidateExecution(reason string) { p.invalidateExecution(reason) }
+
+func parseExecutionChallenge(line []byte) (string, error) {
+	bad := errors.New("invalid private snapshot request")
+	if len(line) > 256 {
+		return "", bad
+	}
+	d := json.NewDecoder(bytes.NewReader(line))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return "", bad
+	}
+	seen := map[string]bool{}
+	challenge := ""
+	version := 0
+	for d.More() {
+		token, err = d.Token()
+		if err != nil {
+			return "", bad
+		}
+		key, ok := token.(string)
+		if !ok || seen[key] {
+			return "", bad
+		}
+		seen[key] = true
+		switch key {
+		case "schema_version":
+			err = d.Decode(&version)
+		case "challenge":
+			err = d.Decode(&challenge)
+		default:
+			return "", bad
+		}
+		if err != nil {
+			return "", bad
+		}
+	}
+	if _, err = d.Token(); err != nil || len(seen) != 2 || version != executionSchema || len(challenge) != 64 {
+		return "", bad
+	}
+	decoded, err := hex.DecodeString(challenge)
+	if err != nil || len(decoded) != 32 || hex.EncodeToString(decoded) != challenge {
+		return "", bad
+	}
+	var extra any
+	if d.Decode(&extra) != io.EOF {
+		return "", bad
+	}
+	return challenge, nil
+}
diff --git a/internal/xray/execution_api.go b/internal/xray/execution_api.go
new file mode 100644
index 00000000..b418fdac
--- /dev/null
+++ b/internal/xray/execution_api.go
@@ -0,0 +1,94 @@
+package xray
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+)
+
+type APIEndpoint struct {
+	Network string
+	Address string
+	owner   *executionOwner
+}
+
+func PreparedExecutionEnabled() bool { return executionRequested() }
+
+func TCPAPIEndpoint(port int) APIEndpoint {
+	if port <= 0 || port > 65535 {
+		return APIEndpoint{}
+	}
+	return APIEndpoint{Network: "tcp", Address: fmt.Sprintf("127.0.0.1:%d", port)}
+}
+
+func (p *Process) GetAPIEndpoint() APIEndpoint {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	if p.execution != nil {
+		return APIEndpoint{Network: "unix", Address: executionCorePath, owner: p.execution}
+	}
+	return TCPAPIEndpoint(p.apiPort)
+}
+
+func (x *XrayAPI) rpcContext() context.Context {
+	ctx := context.Background()
+	if x.ownedExecutionCall {
+		return context.WithValue(ctx, executionCallKey{}, x.execution)
+	}
+	return ctx
+}
+
+func (x *XrayAPI) withExecutionMutation(kind string, payload map[string]any, expected *ExecutionExpected, call func(*XrayAPI) error) error {
+	if x.execution == nil {
+		if expected != nil {
+			return ErrExecutionConflict
+		}
+		return call(x)
+	}
+	local := *x
+	local.ownedExecutionCall = true
+	return x.execution.mutate(kind, payload, expected, func() error { return call(&local) })
+}
+
+func objectPayload(data []byte) map[string]any {
+	object, _ := executionDocument(data)
+	return map[string]any{"object": object}
+}
+
+func (x *XrayAPI) AddInbound(data []byte) error {
+	data = append([]byte(nil), data...)
+	return x.withExecutionMutation("AddInbound", objectPayload(data), nil, func(c *XrayAPI) error { return c.addInboundRaw(data) })
+}
+func (x *XrayAPI) DelInbound(tag string) error {
+	return x.withExecutionMutation("DelInbound", map[string]any{"tag": tag}, nil, func(c *XrayAPI) error { return c.delInboundRaw(tag) })
+}
+func (x *XrayAPI) AddOutbound(data []byte) error {
+	data = append([]byte(nil), data...)
+	return x.withExecutionMutation("AddOutbound", objectPayload(data), nil, func(c *XrayAPI) error { return c.addOutboundRaw(data) })
+}
+func (x *XrayAPI) DelOutbound(tag string) error {
+	return x.withExecutionMutation("DelOutbound", map[string]any{"tag": tag}, nil, func(c *XrayAPI) error { return c.delOutboundRaw(tag) })
+}
+func (x *XrayAPI) ApplyRoutingConfig(data []byte) error { return x.applyRoutingExpected(data, nil) }
+
+// CompareAndApplyRouting is owner-local; no public mutating endpoint exposes it.
+func (x *XrayAPI) CompareAndApplyRouting(data []byte, expected ExecutionExpected) error {
+	return x.applyRoutingExpected(data, &expected)
+}
+func (x *XrayAPI) applyRoutingExpected(data []byte, expected *ExecutionExpected) error {
+	data = append([]byte(nil), data...)
+	routing, _ := executionDocument(data)
+	return x.withExecutionMutation("ApplyRoutingConfig", map[string]any{"routing": routing}, expected, func(c *XrayAPI) error { return c.applyRoutingConfigRaw(data) })
+}
+func (x *XrayAPI) SetBalancerTarget(tag, target string) error {
+	return x.withExecutionMutation("SetBalancerTarget", map[string]any{"tag": tag, "target": target}, nil, func(c *XrayAPI) error { return c.setBalancerTargetRaw(tag, target) })
+}
+func (x *XrayAPI) AddUser(protocol, tag string, user map[string]any) error {
+	// Snapshot caller-owned maps before a native call can mutate execution.
+	data, _ := json.Marshal(user)
+	frozen, _ := executionDocument(data)
+	return x.withExecutionMutation("AddUser", map[string]any{"tag": tag, "protocol": protocol, "user": frozen}, nil, func(c *XrayAPI) error { return c.addUserRaw(protocol, tag, frozen) })
+}
+func (x *XrayAPI) RemoveUser(tag, email string) error {
+	return x.withExecutionMutation("RemoveUser", map[string]any{"tag": tag, "email": email}, nil, func(c *XrayAPI) error { return c.removeUserRaw(tag, email) })
+}
