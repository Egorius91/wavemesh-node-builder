+func TestExecutionSnapshotRequestRejectsAmbiguousOrUnboundedInputs(t *testing.T) {
+	nonce := strings.Repeat("a", 64)
+	good := `{"schema_version":3,"challenge":"` + nonce + `"}`
+	if got, err := parseExecutionChallenge([]byte(good)); err != nil || got != nonce {
