+func TestExecutionCandidateColdDenyUsesSeparateDesiredPreimages(t *testing.T) {
+	const desiredJSON = `{"inbounds":[{"tag":"generated-inbound","protocol":"socks","settings":{"sentinel":"keep"}}],"outbounds":[{"tag":"wm-eu-only-block","protocol":"blackhole"},{"tag":"wm-exit-path-unit","protocol":"blackhole"}],"routing":{"rules":[{"type":"field","inboundTag":["wm-route-unit"],"ruleTag":"wm-rule-unit","outboundTag":"wm-exit-path-unit"}],"sentinel":"desired-only"},"sentinel":"template-only"}`
+	const actualRouting = `{"rules":[{"type":"field","inboundTag":["api"],"outboundTag":"api"},{"type":"field","inboundTag":["wm-route-unit"],"ruleTag":"wm-rule-unit","outboundTag":"wm-eu-only-block"}],"sentinel":"actual-only"}`
+	var desired xray.Config
+	if err := json.Unmarshal([]byte(desiredJSON), &desired); err != nil {
+		t.Fatal(err)
+	}
+	desired.InboundConfigs[0].TuicRelay = true
+	desired.InboundConfigs[0].TuicInboundID = 19
+	before := desired.Clone()
+	candidate, err := buildExecutionSelectorCandidate([]byte(actualRouting), desiredJSON, &desired, "wm-rule-unit", "wm-exit-path-unit")
+	if err != nil {
+		t.Fatalf("cold deny cannot reconcile the selected desired target: %v", err)
+	}
+	if candidate.noOp || !desired.Equals(before) {
+		t.Fatal("native cold transition mistaken for no-op or input mutated")
+	}
+	if !candidate.desired.InboundConfigs[0].TuicRelay || candidate.desired.InboundConfigs[0].TuicInboundID != 19 || !reflect.DeepEqual(candidate.desired.InboundConfigs, before.InboundConfigs) {
+		t.Fatal("generated/panel-only process metadata lost")
+	}
+	actual, _ := executionServiceDocument(candidate.routing)
+	if actual["sentinel"] != "actual-only" || len(actual["rules"].([]any)) != 2 || candidate.template["sentinel"] != "template-only" {
+		t.Fatal("actual and desired documents were substituted")
+	}
+	processAfter, _ := executionServiceDocument(candidate.desired.RouterConfig)
+	if processAfter["sentinel"] != "desired-only" || len(processAfter["rules"].([]any)) != 1 {
+		t.Fatal("generated native rules leaked into process desired config")
+	}
+	// A native no-op cannot commit divergent metadata or clear earlier debt.
+	if _, err := buildExecutionSelectorCandidate(candidate.routing, strings.ReplaceAll(desiredJSON, "\"outboundTag\":\"wm-exit-path-unit\"", "\"outboundTag\":\"wm-eu-only-block\""), &desired, "wm-rule-unit", "wm-exit-path-unit"); !errors.Is(err, errExecutionDesiredConflict) {
+		t.Fatal("native no-op reconciled mismatched template")
+	}
+	noOp, err := buildExecutionSelectorCandidate(candidate.routing, desiredJSON, &desired, "wm-rule-unit", "wm-exit-path-unit")
+	if err != nil || !noOp.noOp {
+		t.Fatal("fully matching no-op was dispatched")
+	}
+	wrong := strings.ReplaceAll(desiredJSON, "wm-route-unit", "wm-route-other")
+	if _, err := buildExecutionSelectorCandidate([]byte(actualRouting), wrong, &desired, "wm-rule-unit", "wm-exit-path-unit"); !errors.Is(err, errExecutionDesiredConflict) {
+		t.Fatal("different inbound binding accepted")
+	}
+}
