+		t.Fatalf("stale execution escaped: %+v", s)
+	}
+}
+
+func TestExecutionCASRejectsStaleEpochBeforeNativeEffects(t *testing.T) {
+	o := newExecutionOwner([]byte(`{"inbounds":[],"outbounds":[],"routing":{"rules":[]}}`), ExecutionIdentity{Generation: "fixture"}, nil)
