+func TestExecutionTemplateConditionalUpdatePreservesConcurrentWriter(t *testing.T) {
+	t.Setenv("XUI_DB_TYPE", "sqlite")
+	dbtest.InitDB(t, filepath.Join(t.TempDir(), "synthetic.db"))
+	db := database.GetDB()
+	if err := db.Where("key = ?", "xrayTemplateConfig").Delete(&model.Setting{}).Error; err != nil {
+		t.Fatal(err)
+	}
+	setting := &XraySettingService{}
+	if _, err := setting.executionTemplate(); !errors.Is(err, errExecutionTemplateConflict) {
+		t.Fatal("missing row was accepted")
+	}
+	if err := setting.compareExecutionTemplate(0, "missing", "candidate"); !errors.Is(err, errExecutionTemplateConflict) {
+		t.Fatal("missing row was created")
+	}
+	row := model.Setting{Key: "xrayTemplateConfig", Value: "original"}
+	if err := db.Create(&row).Error; err != nil {
+		t.Fatal(err)
+	}
+	sentinel := model.Setting{Key: "unrelated", Value: "sentinel"}
+	if err := db.Create(&sentinel).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(&row).Update("value", "newer-ui-value").Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := setting.compareExecutionTemplate(row.Id, "original", "candidate"); !errors.Is(err, errExecutionTemplateConflict) {
+		t.Fatal("concurrent writer was overwritten")
+	}
+	got, err := setting.executionTemplate()
+	if err != nil || got.Value != "newer-ui-value" {
+		t.Fatal("newer row not preserved")
+	}
+	if err := setting.compareExecutionTemplate(row.Id, got.Value, "candidate"); err != nil {
+		t.Fatal(err)
+	}
+	if err := setting.compareExecutionTemplate(row.Id, "candidate", "candidate"); err != nil {
+		t.Fatal("cold actual transition cannot retain an already-selected desired template:", err)
+	}
+	if err := db.First(&sentinel, sentinel.Id).Error; err != nil || sentinel.Value != "sentinel" {
+		t.Fatal("unrelated setting changed")
+	}
+	// Key is indexed, not unique. Refuse duplicates atomically rather than
+	// updating both rows and only then discovering RowsAffected != 1.
+	duplicate := model.Setting{Key: "xrayTemplateConfig", Value: "candidate"}
+	if err := db.Create(&duplicate).Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := setting.executionTemplate(); !errors.Is(err, errExecutionTemplateConflict) {
+		t.Fatal("duplicate template accepted")
+	}
+	if err := setting.compareExecutionTemplate(row.Id, "candidate", "unsafe"); !errors.Is(err, errExecutionTemplateConflict) {
+		t.Fatal("duplicate update accepted")
+	}
+	var rows []model.Setting
+	if err := db.Where("key = ?", row.Key).Find(&rows).Error; err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 2 || rows[0].Value != "candidate" || rows[1].Value != "candidate" {
+		t.Fatal("duplicate refusal changed a row")
+	}
+}
