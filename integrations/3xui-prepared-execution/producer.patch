diff --git a/internal/web/service/xray_builder_loopback_test.go b/internal/web/service/xray_builder_loopback_test.go
new file mode 100644
index 00000000..0abf48f6
--- /dev/null
+++ b/internal/web/service/xray_builder_loopback_test.go
@@ -0,0 +1,134 @@
+package service
+
+import (
+	"bytes"
+	"encoding/json"
+	"flag"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+)
+
+// Fixture regeneration is test-only, writes one fixed testdata path, and never
+// changes production config or installs an input-validator bypass.
+var updateBuilderLoopbackFixture = flag.Bool("update-builder-loopback-fixture", false, "regenerate synthetic GetXrayConfig golden")
+
+func TestExecutionActualBuilderGetXrayConfigSerialization(t *testing.T) {
+	t.Cleanup(SetXrayProcessForTest(nil))
+	directory := filepath.Join("..", "..", "xray", "testdata")
+	raw, err := os.ReadFile(filepath.Join(directory, "builder-loopback-inbounds.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture struct {
+		Cases []struct {
+			Name    string                     `json:"name"`
+			Payload map[string]json.RawMessage `json:"payload"`
+		} `json:"cases"`
+	}
+	if err := json.Unmarshal(raw, &fixture); err != nil || len(fixture.Cases) != 2 {
+		t.Fatal("actual Builder payload fixture missing")
+	}
+	generated := map[string]json.RawMessage{}
+	for _, item := range fixture.Cases {
+		t.Run(item.Name, func(t *testing.T) {
+			setupSettingTestDB(t)
+			// The existing panel accepts these JSON sections as raw strings.
+			// Preserve every field in the actual Builder payload; GetXrayConfig,
+			// ClientService and GenXrayInboundConfig own all normalization.
+			payload := map[string]json.RawMessage{}
+			for key, value := range item.Payload {
+				payload[key] = value
+			}
+			for _, key := range []string{"settings", "streamSettings", "sniffing", "allocate"} {
+				if value, ok := payload[key]; ok {
+					payload[key], _ = json.Marshal(string(value))
+				}
+			}
+			encoded, _ := json.Marshal(payload)
+			var inbound model.Inbound
+			if err := json.Unmarshal(encoded, &inbound); err != nil {
+				t.Fatal(err)
+			}
+			if err := database.GetDB().Create(&inbound).Error; err != nil {
+				t.Fatal(err)
+			}
+			clients, err := ParseInboundSettingsClients(inbound.Settings)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var clientService ClientService
+			if err := clientService.SyncInbound(nil, inbound.Id, clients); err != nil {
+				t.Fatal(err)
+			}
+			template := map[string]any{
+				"log":       map[string]any{"loglevel": "none", "access": "none", "error": "none"},
+				"api":       map[string]any{"tag": "api", "services": []string{"HandlerService", "RoutingService", "StatsService"}},
+				"inbounds":  []any{map[string]any{"tag": "api", "protocol": "tunnel", "listen": "127.0.0.1", "port": 62789, "settings": map[string]any{"address": "127.0.0.1"}}},
+				"outbounds": []any{map[string]any{"tag": "wm-eu-only-block", "protocol": "blackhole"}, map[string]any{"tag": "wm-exit-path-unit", "protocol": "freedom"}},
+				"routing":   map[string]any{"rules": []any{map[string]any{"type": "field", "ruleTag": "wm-api-rule", "inboundTag": []string{"api"}, "outboundTag": "api"}, map[string]any{"type": "field", "ruleTag": "wm-rule-fixture", "inboundTag": []string{inbound.Tag}, "outboundTag": "wm-eu-only-block"}}},
+			}
+			stored, _ := json.Marshal(template)
+			var settings SettingService
+			if err := settings.saveSetting("xrayTemplateConfig", string(stored)); err != nil {
+				t.Fatal(err)
+			}
+			config, err := (&XrayService{}).GetXrayConfig()
+			if err != nil {
+				t.Fatal(err)
+			}
+			encoded, err = json.Marshal(config)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if bytes.Contains(encoded, []byte("externalProxy")) {
+				t.Fatal("owner failed to strip panel-only proxy")
+			}
+			count := -1
+			for _, ib := range config.InboundConfigs {
+				if ib.Tag == inbound.Tag {
+					var fields struct {
+						Clients []map[string]any `json:"clients"`
+					}
+					if json.Unmarshal(ib.Settings, &fields) != nil {
+						t.Fatal("bad normalized settings")
+					}
+					count = len(fields.Clients)
+					for _, c := range fields.Clients {
+						if len(c) != 2 || c["email"] != "fixture-1" || c["id"] != "00000000-0000-4000-8000-000000000001" {
+							t.Fatal("actual dynamic client normalization changed")
+						}
+					}
+				}
+			}
+			if item.Name == "prepared-unpublished-empty" && count != 0 || item.Name == "managed-dynamic-clients" && count != 1 {
+				t.Fatalf("unexpected generated client count %d", count)
+			}
+			generated[item.Name] = encoded
+		})
+	}
+	if t.Failed() {
+		return
+	}
+	encoded, err := json.MarshalIndent(generated, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded = append(encoded, '\n')
+	path := filepath.Join(directory, "builder-getconfig-loopback.json")
+	if *updateBuilderLoopbackFixture {
+		if err := os.WriteFile(path, encoded, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	expected, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(encoded, expected) {
+		t.Fatal("actual complete GetXrayConfig output drifted; inspect/regenerate test-only golden")
+	}
+}
diff --git a/internal/web/service/xray_execution.go b/internal/web/service/xray_execution.go
new file mode 100644
index 00000000..76d2f0e3
--- /dev/null
+++ b/internal/web/service/xray_execution.go
@@ -0,0 +1,246 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"reflect"
+	"strings"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+var errExecutionDesiredConflict = errors.New("execution desired selector conflict")
+var errExecutionOutcomeUnknown = errors.New("execution persistence outcome requires reconciliation")
+
+// ExecutionPersistenceResult describes this operation, never public readiness.
+// Any attempted native call without KnownCommit must be reconciled, not retried.
+type ExecutionPersistenceResult struct {
+	NativeAttempted     bool
+	NativeSucceeded     bool
+	TemplatePersisted   bool
+	ConfigPersisted     bool
+	KnownCommit         bool
+	NoOp                bool
+	ProcessConfigSHA256 string
+}
+
+// ApplyExecutionSelector preserves the internal caller's independent operation
+// context. Actual, template and desired process configurations stay separate;
+// only the same explicitly bound selector changes in each.
+func (s *XrayService) ApplyExecutionSelector(expected xray.ExecutionExpected, templateBefore, ruleTag, target string) (ExecutionPersistenceResult, error) {
+	return s.ApplyExecutionSelectorContext(context.Background(), expected, templateBefore, ruleTag, target)
+}
+
+func (s *XrayService) ApplyExecutionSelectorContext(ctx context.Context, expected xray.ExecutionExpected, templateBefore, ruleTag, target string) (ExecutionPersistenceResult, error) {
+	lock.Lock()
+	defer lock.Unlock()
+	var result ExecutionPersistenceResult
+	if ctx == nil {
+		return result, context.Canceled
+	}
+	if err := ctx.Err(); err != nil {
+		return result, err
+	}
+	p := currentXrayProcess()
+	if p == nil || !p.IsRunning() {
+		return result, ErrXrayNotRunning
+	}
+	setting := &XraySettingService{}
+	row, err := setting.executionTemplate()
+	if err != nil {
+		return result, err
+	}
+	if row.Value != templateBefore {
+		return result, errExecutionTemplateConflict
+	}
+	var api xray.XrayAPI
+	if err := api.InitEndpoint(p.GetAPIEndpoint()); err != nil {
+		return result, err
+	}
+	defer api.Close()
+	actualRouting, err := api.ExecutionRoutingContext(ctx, expected)
+	if err != nil {
+		return result, err
+	}
+	candidate, err := buildExecutionSelectorCandidate(actualRouting, templateBefore, p.CloneConfig(), ruleTag, target)
+	if err != nil {
+		return result, err
+	}
+	if candidate.noOp {
+		result.NoOp = true
+		return result, nil
+	}
+	templateAfter, _ := json.Marshal(candidate.template)
+	prepared, err := setting.prepareXraySetting(string(templateAfter))
+	if err != nil {
+		return result, err
+	}
+	normalized, err := executionServiceDocument([]byte(prepared))
+	if err != nil || !reflect.DeepEqual(candidate.template, normalized) {
+		return result, errExecutionDesiredConflict
+	}
+	outcome, err := api.CompareAndApplyRoutingAndPersistContext(ctx, candidate.routing, expected, func() error {
+		return persistExecutionSelector(setting, p, row, prepared, candidate.desired, &result)
+	})
+	result.NativeAttempted, result.NativeSucceeded = outcome.NativeAttempted, outcome.NativeSucceeded
+	result.KnownCommit = err == nil && outcome.Persisted && outcome.OwnerConfirmed && result.TemplatePersisted && result.ConfigPersisted && result.ProcessConfigSHA256 != ""
+	if err == nil && !result.KnownCommit {
+		err = errExecutionOutcomeUnknown
+	}
+	return result, err
+}
+
+type executionSelectorCandidate struct {
+	routing  []byte
+	template map[string]any
+	desired  *xray.Config
+	noOp     bool
+}
+
+// Builds independent selector deltas without replacing native/generated or
+// unrelated desired sections. Its input Config remains untouched.
+func buildExecutionSelectorCandidate(actualRouting []byte, templateBefore string, desired *xray.Config, ruleTag, target string) (*executionSelectorCandidate, error) {
+	// Preserve panel-only metadata and unrelated RawMessage bytes.
+	desired = desired.Clone()
+	processBytes, err := json.Marshal(desired)
+	if err != nil || bytes.Equal(processBytes, []byte("null")) {
+		return nil, errExecutionDesiredConflict
+	}
+	processDoc, err := executionServiceDocument(processBytes)
+	if err != nil {
+		return nil, err
+	}
+	templateDoc, err := executionServiceDocument([]byte(templateBefore))
+	if err != nil {
+		return nil, err
+	}
+	actual, err := executionServiceDocument(actualRouting)
+	if err != nil {
+		return nil, err
+	}
+	actualBefore, binding, err := replaceExecutionSelector(actual, ruleTag, target)
+	if err != nil {
+		return nil, err
+	}
+	var desiredTargets []string
+	for _, doc := range []map[string]any{templateDoc, processDoc} {
+		routing, ok := doc["routing"].(map[string]any)
+		if !ok || !executionTargetExists(doc, target) {
+			return nil, errExecutionDesiredConflict
+		}
+		before, desiredBinding, err := replaceExecutionSelector(routing, ruleTag, target)
+		if err != nil || !reflect.DeepEqual(binding, desiredBinding) {
+			return nil, errExecutionDesiredConflict
+		}
+		desiredTargets = append(desiredTargets, before)
+	}
+	if actualBefore == target {
+		if desiredTargets[0] != target || desiredTargets[1] != target {
+			// Native no-op cannot silently reconcile divergent persisted state.
+			return nil, errExecutionDesiredConflict
+		}
+		return &executionSelectorCandidate{noOp: true}, nil
+	}
+	// Cold launch deliberately blocks the consumed selector while preserving
+	// persisted desired selection. Each desired copy has its own preimage; only
+	// its bound rule changes. The native CAS still uses the actual preimage.
+
+	processRouting, _ := json.Marshal(processDoc["routing"])
+	desired.RouterConfig = processRouting
+	nativeAfter, _ := json.Marshal(actual)
+	return &executionSelectorCandidate{routing: nativeAfter, template: templateDoc, desired: desired}, nil
+}
+
+// Called only after the single native RPC returned success. Failure leaves the
+// operation unknown; there is no restore, restart or compensating write here.
+func persistExecutionSelector(setting *XraySettingService, p *xray.Process, before *model.Setting, after string, desired *xray.Config, result *ExecutionPersistenceResult) error {
+	if err := setting.compareExecutionTemplate(before.Id, before.Value, after); err != nil {
+		return err
+	}
+	result.TemplatePersisted = true
+	processHash, err := p.PersistExecutionConfig(desired)
+	if err != nil {
+		return err
+	}
+	result.ConfigPersisted = true
+	result.ProcessConfigSHA256 = processHash
+	return nil
+}
+
+func executionServiceDocument(data []byte) (map[string]any, error) {
+	d := json.NewDecoder(bytes.NewReader(data))
+	d.UseNumber()
+	var doc map[string]any
+	if err := d.Decode(&doc); err != nil || doc == nil {
+		return nil, errExecutionDesiredConflict
+	}
+	var trailing any
+	if err := d.Decode(&trailing); err != io.EOF {
+		return nil, errExecutionDesiredConflict
+	}
+	return doc, nil
+}
+
+// Operates only on a detached copy; refuses duplicates and ambiguous rules.
+func replaceExecutionSelector(routing map[string]any, tag, target string) (string, map[string]any, error) {
+	if !strings.HasPrefix(tag, "wm-rule-") || !executionSelectorTarget(target) {
+		return "", nil, errExecutionDesiredConflict
+	}
+	rules, ok := routing["rules"].([]any)
+	if !ok {
+		return "", nil, errExecutionDesiredConflict
+	}
+	var selected map[string]any
+	for _, raw := range rules {
+		rule, ok := raw.(map[string]any)
+		if !ok {
+			return "", nil, errExecutionDesiredConflict
+		}
+		if rule["ruleTag"] == tag {
+			if selected != nil {
+				return "", nil, errExecutionDesiredConflict
+			}
+			selected = rule
+		}
+	}
+	if selected == nil || len(selected) != 4 || selected["type"] != "field" {
+		return "", nil, errExecutionDesiredConflict
+	}
+	inbounds, ok := selected["inboundTag"].([]any)
+	if !ok || len(inbounds) != 1 {
+		return "", nil, errExecutionDesiredConflict
+	}
+	inbound, ok := inbounds[0].(string)
+	before, ok2 := selected["outboundTag"].(string)
+	if !ok || !ok2 || !strings.HasPrefix(inbound, "wm-route-") || !executionSelectorTarget(before) {
+		return "", nil, errExecutionDesiredConflict
+	}
+	selected["outboundTag"] = target
+	return before, map[string]any{"ruleTag": tag, "inboundTag": inbound}, nil
+}
+
+func executionSelectorTarget(tag string) bool {
+	return tag == "wm-eu-only-block" || strings.HasPrefix(tag, "wm-exit-path-")
+}
+
+func executionTargetExists(doc map[string]any, target string) bool {
+	items, ok := doc["outbounds"].([]any)
+	if !ok {
+		return false
+	}
+	count := 0
+	for _, raw := range items {
+		outbound, ok := raw.(map[string]any)
+		if !ok {
+			return false
+		}
+		if outbound["tag"] == target {
+			count++
+		}
+	}
+	return count == 1
+}
