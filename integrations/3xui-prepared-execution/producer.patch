+func TestExecutionServiceWithoutRunningProcessHasNoEffects(t *testing.T) {
+	previous, _ := xrayState.snapshot()
+	xrayState.replace(nil)
+	t.Cleanup(func() { xrayState.replace(previous) })
+	result, err := (&XrayService{}).ApplyExecutionSelector(xray.ExecutionExpected{}, "", "wm-rule-unit", "wm-exit-path-unit")
+	if !errors.Is(err, ErrXrayNotRunning) || !reflect.DeepEqual(result, ExecutionPersistenceResult{}) {
+		t.Fatal("missing process reached mutation")
+	}
+}
