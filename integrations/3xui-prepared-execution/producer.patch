+func nativeSnapshot(t *testing.T) ExecutionSnapshot {
+	t.Helper()
+	c, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: executionSnapshotPath, Net: "unix"})
+	if err != nil {
+		t.Fatal("private snapshot dial failed")
+	}
+	defer c.Close()
+	cred, err := unixPeer(c)
+	if err != nil || cred.Uid != 0 || int(cred.Pid) != os.Getpid() {
+		t.Fatal("producer peer credentials mismatch")
+	}
+	nonce := make([]byte, 32)
+	if _, err = rand.Read(nonce); err != nil {
+		t.Fatal("challenge entropy unavailable")
+	}
+	challenge := hex.EncodeToString(nonce)
+	_ = c.SetDeadline(time.Now().Add(3 * time.Second))
+	_, err = c.Write(append(executionJSON(map[string]any{"schema_version": 3, "challenge": challenge}), '\n'))
+	if err != nil {
+		t.Fatal("private snapshot request failed")
+	}
+	line, err := bufio.NewReader(io.LimitReader(c, 4<<20)).ReadBytes('\n')
+	if err != nil {
+		t.Fatal("private snapshot response failed")
+	}
+	var s ExecutionSnapshot
+	d := json.NewDecoder(bytes.NewReader(line))
+	d.DisallowUnknownFields()
+	if d.Decode(&s) != nil || s.Challenge != challenge || s.SchemaVersion != 3 {
+		t.Fatal("snapshot response challenge or schema mismatch")
+	}
+	return s
+}
