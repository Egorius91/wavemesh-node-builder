index 00000000..e81a855e
--- /dev/null
+++ b/internal/xray/execution_loopback.go
@@ -0,0 +1,113 @@
+package xray
+
+import (
+	"encoding/json"
+	"regexp"
+	"strings"
+
+	"github.com/google/uuid"
+)
+
+var executionLoopbackTag = regexp.MustCompile(`^wm-route-[A-Za-z0-9][A-Za-z0-9_.-]{0,118}$`)
+var executionLoopbackEmail = regexp.MustCompile(`^[A-Za-z0-9_.@+-]{1,256}$`)
+var executionLoopbackPath = regexp.MustCompile(`^/api/(?:[A-Za-z0-9_-]+/)+$`)
+var executionLoopbackHostLabel = regexp.MustCompile(`^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$`)
+
+func executionObjectKeys(value map[string]any, names ...string) bool {
+	if len(value) != len(names) {
+		return false
+	}
+	for _, name := range names {
+		if _, ok := value[name]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+// Only the exact runtime_state -> GetXrayConfig generated class. This admits
+// immutable custody of a local transport, with no public TLS/profile semantics.
+func executionManagedLoopbackIngress(ib map[string]any) bool {
+	if !executionObjectKeys(ib, "listen", "port", "protocol", "settings", "streamSettings", "tag", "sniffing") || ib["listen"] != "127.0.0.1" || ib["protocol"] != "vless" {
+		return false
+	}
+	tag, ok := ib["tag"].(string)
+	if !ok || len(tag) > 128 || !executionLoopbackTag.MatchString(tag) {
+		return false
+	}
+	port, ok := ib["port"].(json.Number)
+	if !ok {
+		return false
+	}
+	number, err := port.Int64()
+	if err != nil || number < 1 || number > 65535 {
+		return false
+	}
+	settings, ok := ib["settings"].(map[string]any)
+	if !ok || !executionObjectKeys(settings, "clients", "decryption", "fallbacks") || settings["decryption"] != "none" {
+		return false
+	}
+	fallbacks, ok := settings["fallbacks"].([]any)
+	if !ok || len(fallbacks) != 0 {
+		return false
+	}
+	clients, ok := settings["clients"].([]any)
+	if !ok {
+		return false
+	}
+	ids, emails := map[string]bool{}, map[string]bool{}
+	for _, value := range clients {
+		client, ok := value.(map[string]any)
+		if !ok || !executionObjectKeys(client, "email", "id") {
+			return false
+		}
+		email, ok := client["email"].(string)
+		if !ok || !executionLoopbackEmail.MatchString(email) || emails[email] {
+			return false
+		}
+		id, ok := client["id"].(string)
+		if !ok {
+			return false
+		}
+		parsed, err := uuid.Parse(id)
+		if err != nil || parsed == uuid.Nil || parsed.String() != id || ids[id] {
+			return false
+		}
+		ids[id], emails[email] = true, true
+	}
+	stream, ok := ib["streamSettings"].(map[string]any)
+	if !ok || !executionObjectKeys(stream, "network", "security", "xhttpSettings") || stream["network"] != "xhttp" || stream["security"] != "none" {
+		return false
+	}
+	xhttp, ok := stream["xhttpSettings"].(map[string]any)
+	if !ok || !executionObjectKeys(xhttp, "path", "host", "mode") || xhttp["mode"] != "stream-one" {
+		return false
+	}
+	path, ok := xhttp["path"].(string)
+	if !ok || len(path) > 256 || !executionLoopbackPath.MatchString(path) {
+		return false
+	}
+	host, ok := xhttp["host"].(string)
+	if !ok || len(host) == 0 || len(host) > 253 {
+		return false
+	}
+	for _, label := range strings.Split(host, ".") {
+		if !executionLoopbackHostLabel.MatchString(label) {
+			return false
+		}
+	}
+	sniffing, ok := ib["sniffing"].(map[string]any)
+	if !ok || !executionObjectKeys(sniffing, "enabled", "destOverride", "metadataOnly", "routeOnly") || sniffing["enabled"] != true || sniffing["metadataOnly"] != false || sniffing["routeOnly"] != false {
+		return false
+	}
+	destinations, ok := sniffing["destOverride"].([]any)
+	if !ok || len(destinations) != 4 {
+		return false
+	}
+	for index, name := range []string{"http", "tls", "quic", "fakedns"} {
+		if destinations[index] != name {
+			return false
+		}
+	}
+	return true
+}
