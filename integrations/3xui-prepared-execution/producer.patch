+func TestExecutionSnapshotCannotExposeAQualifiedPrefixOfLostMutation(t *testing.T) {
+	o := executionFixture(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	mutationDone := make(chan error, 1)
+	go func() {
+		mutationDone <- o.mutate("DelInbound", map[string]any{"tag": "wm-route-unit"}, nil, func() error { close(entered); <-release; return errors.New("lost native response") })
+	}()
+	<-entered
+	result := make(chan ExecutionSnapshot, 1)
+	attempted := make(chan struct{})
+	go func() { close(attempted); result <- o.snapshot("concurrent") }()
+	<-attempted
+	select {
+	case s := <-result:
+		close(release)
+		t.Fatalf("snapshot interleaved with mutation: %+v", s)
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	if err := <-mutationDone; err == nil || err.Error() != "lost native response" {
+		t.Fatalf("mutation outcome %v", err)
+	}
+	s := <-result
+	if s.Qualified || s.Config != nil || s.EffectiveSHA256 != "" || s.ExecutionSHA256 != "" || s.Epoch != "1" {
+		t.Fatalf("qualified stale prefix: %+v", s)
+	}
+}
