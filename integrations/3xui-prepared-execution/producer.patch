+		o.reason = "custody_attested"
+	}
+	o.mu.Unlock()
+	go o.serveExecutionSnapshots(listener)
+	return nil
+}
+
+func verifyPrivateSocket(path string) error {
+	var st unix.Stat_t
+	if err := unix.Lstat(path, &st); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFSOCK || st.Uid != 0 || st.Mode&0777 != 0600 {
+		return errors.New("unowned native socket")
+	}
+	return nil
+}
+
+func unixPeer(c *net.UnixConn) (*unix.Ucred, error) {
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return nil, err
+	}
+	var cred *unix.Ucred
+	var inner error
+	err = raw.Control(func(fd uintptr) { cred, inner = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED) })
+	if err != nil {
+		return nil, err
+	}
+	return cred, inner
+}
+
+func dialExecutionCore(ctx context.Context, endpoint APIEndpoint) (net.Conn, error) {
+	var d net.Dialer
+	c, err := d.DialContext(ctx, "unix", endpoint.Address)
+	if err != nil {
+		return nil, err
+	}
+	u, ok := c.(*net.UnixConn)
+	if !ok {
+		c.Close()
+		return nil, errors.New("native socket type mismatch")
+	}
+	cred, err := unixPeer(u)
+	if err != nil || cred.Uid != 0 || int64(cred.Pid) != endpoint.owner.peerPID.Load() {
+		c.Close()
+		return nil, errors.New("native peer identity mismatch")
+	}
+	expected, ok := endpoint.owner.peerStartTicks.Load().(string)
+	ticks, err := procStartTicks(int(cred.Pid))
+	if !ok || err != nil || ticks != expected {
+		c.Close()
+		return nil, errors.New("native peer process instance mismatch")
+	}
+	return c, nil
+}
+
+func (o *executionOwner) serveExecutionSnapshots(listener *net.UnixListener) {
+	for {
+		c, err := listener.AcceptUnix()
+		if err != nil {
+			return
+		}
+		o.handleExecutionSnapshot(c)
+		c.Close()
+	}
+}
+
+func (o *executionOwner) handleExecutionSnapshot(c *net.UnixConn) {
+	_ = c.SetDeadline(time.Now().Add(time.Second))
+	cred, err := unixPeer(c)
+	if err != nil || cred.Uid != 0 || cred.Pid <= 0 {
+		return
+	}
+	reader := bufio.NewReader(io.LimitReader(c, 257))
+	line, err := reader.ReadBytes('\n')
+	if err != nil || len(line) > 256 {
+		return
+	}
+	challenge, err := parseExecutionChallenge(line)
+	if err != nil {
+		return
+	}
+	s := o.snapshot(challenge)
+	data := executionJSON(s)
+	if len(data) > 4<<20 {
+		return
+	}
+	_, _ = c.Write(append(data, '\n'))
+}
+
+func executionRequested() bool { return os.Getenv("XUI_PREPARED_ATTESTATION") == "1" }
