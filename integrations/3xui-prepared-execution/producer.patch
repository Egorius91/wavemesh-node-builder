+			data, err := os.ReadFile(path)
+			if err != nil || hash != fmt.Sprintf("%x", sha256.Sum256(data)) {
+				t.Fatal("missing/stale disk contaminated owner postimage")
+			}
+			if !p.GetConfig().Equals(&desired) {
+				t.Fatal("memory desired replaced by disk contents")
+			}
+		})
