+func TestExecutionSelectorCopyRetainsUnrelatedRoutingAndRejectsAmbiguity(t *testing.T) {
+	const raw = `{"rules":[{"ruleTag":"sentinel","type":"field","domain":["example.invalid"],"outboundTag":"direct"},{"ruleTag":"wm-rule-unit","type":"field","inboundTag":["wm-route-unit"],"outboundTag":"wm-eu-only-block"}],"domainStrategy":"AsIs","sentinel":{"keep":42}}`
+	doc, err := executionServiceDocument([]byte(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	beforeSentinel, _ := json.Marshal(doc["rules"].([]any)[0])
+	before, binding, err := replaceExecutionSelector(doc, "wm-rule-unit", "wm-exit-path-unit")
+	afterSentinel, _ := json.Marshal(doc["rules"].([]any)[0])
+	if err != nil || before != "wm-eu-only-block" || binding["inboundTag"] != "wm-route-unit" || string(beforeSentinel) != string(afterSentinel) || doc["domainStrategy"] != "AsIs" || doc["sentinel"] == nil {
+		t.Fatal("selector delta changed unrelated state")
+	}
+	for _, kind := range []string{"duplicate", "extra-field", "multiple-inbounds", "foreign-target", "malformed", "trailing"} {
+		t.Run(kind, func(t *testing.T) {
+			input := raw
+			if kind == "malformed" {
+				input = "null"
+			}
+			if kind == "trailing" {
+				input = raw + "{}"
+			}
+			d, err := executionServiceDocument([]byte(input))
+			if kind == "malformed" || kind == "trailing" {
+				if err == nil {
+					t.Fatal("ambiguous document accepted")
+				}
+				return
+			}
+			rules := d["rules"].([]any)
+			rule := rules[1].(map[string]any)
+			target := "wm-exit-path-unit"
+			switch kind {
+			case "duplicate":
+				d["rules"] = append(rules, rule)
+			case "extra-field":
+				rule["network"] = "tcp"
+			case "multiple-inbounds":
+				rule["inboundTag"] = []any{"wm-route-unit", "other"}
+			case "foreign-target":
+				target = "direct"
+			}
+			if _, _, err = replaceExecutionSelector(d, "wm-rule-unit", target); err == nil {
+				t.Fatal("unsupported selector accepted")
+			}
+		})
+	}
+}
