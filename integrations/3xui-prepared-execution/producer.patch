+++ b/internal/xray/execution_override_test.go
@@ -0,0 +1,121 @@
+package xray
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestExecutionOverrideRejectsUnsafeTargetsBeforeNativeEffects(t *testing.T) {
+	for _, target := range []string{"api", "missing-outbound"} {
+		t.Run(target, func(t *testing.T) {
+			o := executionFixture(t)
+			before := o.snapshot("before")
+			called := false
+			err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": target}, nil, func() error { called = true; return nil })
+			after := o.snapshot("after")
+			if !errors.Is(err, ErrExecutionControlBoundary) || called || !after.Qualified || after.ExecutionSHA256 != before.ExecutionSHA256 || after.Epoch != before.Epoch || len(after.Overrides) != 0 {
+				t.Fatalf("unsafe override was not refused before effects: error=%v called=%v qualified=%v epoch=%s", err, called, after.Qualified, after.Epoch)
+			}
+		})
+	}
+}
+
+func TestExecutionSupportedOverrideAndClearRemainQualified(t *testing.T) {
+	o := executionFixture(t)
+	before := o.snapshot("initial")
+	for i, target := range []string{"wm-exit-path-unit", ""} {
+		calls := 0
+		if err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": target}, nil, func() error { calls++; return nil }); err != nil || calls != 1 {
+			t.Fatalf("supported override failed: error=%v calls=%d", err, calls)
+		}
+		s := o.snapshot("current")
+		if !s.Qualified || s.Overrides["unit-balancer"] != target || s.EffectiveSHA256 != before.EffectiveSHA256 || o.epoch != uint64(i+1) {
+			t.Fatalf("supported override execution lost: qualified=%v epoch=%s", s.Qualified, s.Epoch)
+		}
+	}
+	if s := o.snapshot("cleared"); len(s.Overrides) != 0 || s.ExecutionSHA256 != before.ExecutionSHA256 {
+		t.Fatal("cleared override did not return to the same execution with a newer epoch")
+	}
+}
+
+func TestExecutionRemovedOverrideTargetStaysUnknownAfterClearAndShadow(t *testing.T) {
+	o := executionFixture(t)
+	if err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": "wm-exit-path-unit"}, nil, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	called := false
+	if err := o.mutate("DelOutbound", map[string]any{"tag": "wm-exit-path-unit"}, nil, func() error { called = true; return nil }); err != nil || !called {
+		t.Fatalf("native removal result changed: %v called=%v", err, called)
+	}
+	s := o.snapshot("removed")
+	if s.Qualified || s.Config != nil || s.ExecutionSHA256 != "" || s.Epoch != "2" {
+		t.Fatalf("dangling override was qualified: qualified=%v epoch=%s", s.Qualified, s.Epoch)
+	}
+	if err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": ""}, nil, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	p := NewProcess(&Config{})
+	p.execution = o
+	p.SetConfig(&Config{})
+	if s := o.snapshot("after-clear-shadow"); s.Qualified || s.Config != nil || s.Epoch != "3" {
+		t.Fatal("clear or desired shadow resealed unknown native execution")
+	}
+}
+
+func TestExecutionRoutingReplacementCannotResealAnExistingOverride(t *testing.T) {
+	o := executionFixture(t)
+	if err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": "wm-exit-path-unit"}, nil, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	routing := fixtureRouting(o, "wm-eu-only-block")
+	routing["balancers"] = []any{}
+	if err := o.mutate("ApplyRoutingConfig", map[string]any{"routing": routing}, nil, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if s := o.snapshot("after-routing"); s.Qualified || s.Config != nil || s.Epoch != "2" {
+		t.Fatal("routing replacement retained qualified override state")
+	}
+}
+
+func TestExecutionUnknownOverrideCannotRecoverThroughAnotherTarget(t *testing.T) {
+	o := executionFixture(t)
+	lost := errors.New("lost native override reply")
+	if err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": "wm-exit-path-unit"}, nil, func() error { return lost }); !errors.Is(err, lost) {
+		t.Fatal("lost result was changed")
+	}
+	called := false
+	err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": "sentinel"}, nil, func() error { called = true; return nil })
+	if !errors.Is(err, ErrExecutionConflict) || called || o.epoch != 1 {
+		t.Fatalf("unknown state admitted another target: err=%v called=%v epoch=%d", err, called, o.epoch)
+	}
+	if err := o.mutate("SetBalancerTarget", map[string]any{"tag": "unit-balancer", "target": ""}, nil, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if s := o.snapshot("after-clear"); s.Qualified || s.Config != nil || s.Epoch != "2" {
+		t.Fatal("successful clear resealed a lost native mutation")
+	}
+}
+
+func TestExecutionKnownControlRedirectionIsRefusedBeforeEffects(t *testing.T) {
+	for _, kind := range []string{"ApplyRoutingConfig", "AddOutbound", "DelInbound"} {
+		t.Run(kind, func(t *testing.T) {
+			o := executionFixture(t)
+			payload := map[string]any{"tag": "api"}
+			if kind == "ApplyRoutingConfig" {
+				routing := fixtureRouting(o, "wm-eu-only-block")
+				routing["rules"].([]any)[0].(map[string]any)["inboundTag"] = []any{"wm-route-unit"}
+				payload = map[string]any{"routing": routing}
+			}
+			if kind == "AddOutbound" {
+				payload = map[string]any{"object": map[string]any{"tag": "loop-to-control", "protocol": "loopback", "settings": map[string]any{"inboundTag": "api"}}}
+			}
+			before := o.snapshot("before")
+			called := false
+			err := o.mutate(kind, payload, nil, func() error { called = true; return nil })
+			after := o.snapshot("after")
+			if !errors.Is(err, ErrExecutionControlBoundary) || called || !after.Qualified || after.ExecutionSHA256 != before.ExecutionSHA256 || after.Epoch != before.Epoch {
+				t.Fatalf("known control effect was not refused: kind=%s err=%v called=%v qualified=%v", kind, err, called, after.Qualified)
+			}
+		})
+	}
+}
diff --git a/internal/xray/execution_persist_test.go b/internal/xray/execution_persist_test.go
new file mode 100644
index 00000000..7af4644e
--- /dev/null
+++ b/internal/xray/execution_persist_test.go
@@ -0,0 +1,262 @@
+package xray
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	routerService "github.com/xtls/xray-core/app/router/command"
+	"google.golang.org/grpc"
+)
+
+type persistenceRoutingClient struct {
+	routerService.RoutingServiceClient
+	call func() error
+}
+
+func (c persistenceRoutingClient) AddRule(_ context.Context, req *routerService.AddRuleRequest, _ ...grpc.CallOption) (*routerService.AddRuleResponse, error) {
+	if req.ShouldAppend {
+		return nil, errors.New("unexpected append")
+	}
+	return &routerService.AddRuleResponse{}, c.call()
+}
+
+func persistenceAPI(o *executionOwner, call func() error) *XrayAPI {
+	var client routerService.RoutingServiceClient = persistenceRoutingClient{call: call}
+	return &XrayAPI{execution: o, RoutingServiceClient: &client}
+}
+
+func TestExecutionPersistBarrierBlocksSnapshotUntilBothStagesComplete(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(map[bool]string{false: "success", true: "persist-error"}[fail], func(t *testing.T) {
+			o := executionFixture(t)
+			before := o.snapshot("")
+			expected := ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch}
+			nativeEntered, nativeRelease := make(chan struct{}), make(chan struct{})
+			persistEntered, persistRelease := make(chan struct{}), make(chan struct{})
+			nativeCount, persistCount := 0, 0
+			api := persistenceAPI(o, func() error { nativeCount++; close(nativeEntered); <-nativeRelease; return nil })
+			type completed struct {
+				outcome RoutingPersistenceOutcome
+				err     error
+			}
+			done := make(chan completed, 1)
+			data := executionJSON(fixtureRouting(o, "wm-exit-path-unit"))
+			go func() {
+				outcome, err := api.CompareAndApplyRoutingAndPersist(data, expected, func() error {
+					persistCount++
+					close(persistEntered)
+					<-persistRelease
+					if fail {
+						return errors.New("synthetic persistence failure")
+					}
+					return nil
+				})
+				done <- completed{outcome, err}
+			}()
+			<-nativeEntered
+			snapshots := make(chan ExecutionSnapshot, 1)
+			attempted := make(chan struct{})
+			go func() { close(attempted); snapshots <- o.snapshot("during-native-and-persist") }()
+			<-attempted
+			select {
+			case <-snapshots:
+				t.Fatal("snapshot escaped native barrier")
+			case <-time.After(20 * time.Millisecond):
+			}
+			close(nativeRelease)
+			<-persistEntered
+			select {
+			case <-snapshots:
+				t.Fatal("snapshot escaped persistence barrier")
+			case <-time.After(20 * time.Millisecond):
+			}
+			close(persistRelease)
+			result := <-done
+			snapshot := <-snapshots
+			if nativeCount != 1 || persistCount != 1 || !result.outcome.NativeAttempted || !result.outcome.NativeSucceeded {
+				t.Fatalf("incorrect call accounting: %+v native=%d persist=%d", result, nativeCount, persistCount)
+			}
+			if fail {
+				if result.err == nil || result.outcome.Persisted || result.outcome.OwnerConfirmed || snapshot.Qualified || snapshot.Config != nil {
+					t.Fatal("failed persistence became qualified")
+				}
+			} else if result.err != nil || !result.outcome.Persisted || !result.outcome.OwnerConfirmed || !snapshot.Qualified || snapshot.Transition == nil {
+				t.Fatalf("completed barrier not confirmed: %+v", result)
+			}
+		})
+	}
+}
+
+func TestExecutionPersistRefusalsAndNoOpHaveNoCallbacks(t *testing.T) {
+	for _, kind := range []string{"stale", "generation", "nil-persist", "no-op", "unsupported", "no-owner"} {
+		t.Run(kind, func(t *testing.T) {
+			o := executionFixture(t)
+			before := o.snapshot("")
+			expected := ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch}
+			calls := 0
+			api := persistenceAPI(o, func() error { calls++; return nil })
+			persist := func() error { calls++; return nil }
+			routing := fixtureRouting(o, "wm-exit-path-unit")
+			switch kind {
+			case "stale":
+				expected.Epoch = "99"
+			case "generation":
+				expected.Generation = "different"
+			case "nil-persist":
+				persist = nil
+			case "no-op":
+				routing = fixtureRouting(o, "wm-eu-only-block")
+			case "unsupported":
+				routing["domainStrategy"] = "IPIfNonMatch"
+			case "no-owner":
+				api.execution = nil
+			}
+			outcome, err := api.CompareAndApplyRoutingAndPersist(executionJSON(routing), expected, persist)
+			if calls != 0 || outcome != (RoutingPersistenceOutcome{}) {
+				t.Fatalf("refusal dispatched: %s %+v count=%d", kind, outcome, calls)
+			}
+			if (kind == "no-op") != (err == nil) {
+				t.Fatalf("unexpected refusal/no-op: %s %v", kind, err)
+			}
+			if after := o.snapshot(""); after.Epoch != before.Epoch || after.EffectiveSHA256 != before.EffectiveSHA256 {
+				t.Fatal("refusal mutated owner")
+			}
+		})
+	}
+}
+
+func TestExecutionPersistNativeFailureIsSingleCallWithoutPersistence(t *testing.T) {
+	o := executionFixture(t)
+	before := o.snapshot("")
+	count := 0
+	failure := errors.New("synthetic lost native reply")
+	api := persistenceAPI(o, func() error { count++; return failure })
+	outcome, err := api.CompareAndApplyRoutingAndPersist(executionJSON(fixtureRouting(o, "wm-exit-path-unit")), ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch}, func() error { t.Fatal("persist after native failure"); return nil })
+	if !errors.Is(err, failure) || count != 1 || !outcome.NativeAttempted || outcome.NativeSucceeded || outcome.Persisted || outcome.OwnerConfirmed || o.snapshot("").Qualified {
+		t.Fatalf("unknown native outcome: %+v %v count=%d", outcome, err, count)
+	}
+}
+
+func TestPersistExecutionConfigIsDetachedAndCannotReenterOwnerOnFailure(t *testing.T) {
+	o := executionFixture(t)
+	old := &Config{}
+	p := NewTestProcess(old, filepath.Join(t.TempDir(), "missing", "config.json"))
+	p.execution = o
+	done := make(chan error, 1)
+	failedHash := ""
+	go func() {
+		done <- o.mutate("ApplyRoutingConfig", map[string]any{"routing": fixtureRouting(o, "wm-exit-path-unit")}, nil, func() error {
+			var err error
+			failedHash, err = p.PersistExecutionConfig(&Config{})
+			return err
+		})
+	}()
+	select {
+	case err := <-done:
+		if err == nil || failedHash != "" || p.GetConfig() != old || o.snapshot("").Qualified {
+			t.Fatal("failed file write advanced shadow/owner")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("owner reentrant persistence deadlock")
+	}
+	path := filepath.Join(t.TempDir(), "config.json")
+	p = NewTestProcess(old, path)
+	var desired Config
+	if err := json.Unmarshal(executionJSON(o.config), &desired); err != nil {
+		t.Fatal(err)
+	}
+	desired.InboundConfigs[1].TuicRelay = true
+	desired.InboundConfigs[1].TuicInboundID = 42
+	desired.RouterConfig = append([]byte(" \n"), desired.RouterConfig...)
+	postHash, err := p.PersistExecutionConfig(&desired)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.GetConfig().Equals(&desired) || !p.GetConfig().InboundConfigs[1].TuicRelay || p.GetConfig().InboundConfigs[1].TuicInboundID != 42 {
+		t.Fatal("clone reformatted RawMessages or dropped panel-only inbound metadata")
+	}
+	frozen, _ := os.ReadFile(path)
+	if postHash != fmt.Sprintf("%x", sha256.Sum256(frozen)) {
+		t.Fatal("owner hash differs from the exact persisted payload")
+	}
+	desired.RouterConfig[0] = 'X'
+	desired.InboundConfigs[1].Settings[0] = 'X'
+	after, _ := os.ReadFile(path)
+	if string(frozen) != string(after) || p.GetConfig().RouterConfig[0] == 'X' || p.GetConfig().InboundConfigs[1].Settings[0] == 'X' {
+		t.Fatal("persisted config aliases caller")
+	}
+}
+
+func TestPersistExecutionConfigUsesMemoryDesiredWithoutAValidStartupDisk(t *testing.T) {
+	for _, stale := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stale=%t", stale), func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.json")
+			if stale {
+				if err := os.WriteFile(path, []byte("stale non-JSON disk is not memory desired"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var desired Config
+			if err := json.Unmarshal(executionJSON(executionFixture(t).config), &desired); err != nil {
+				t.Fatal(err)
+			}
+			p := NewTestProcess(&desired, path)
