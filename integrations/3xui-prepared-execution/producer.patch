+func executionFixture(t *testing.T) *executionOwner {
+	t.Helper()
+	data := []byte(`{"api":{"tag":"api","services":["HandlerService","RoutingService","StatsService"]},"inbounds":[{"tag":"api","protocol":"tunnel","listen":"127.0.0.1","port":62789,"settings":{"rewriteAddress":"127.0.0.1"}},{"tag":"wm-route-unit","protocol":"vless","port":12345,"settings":{"clients":[{"email":"old@example.invalid","id":"00000000-0000-4000-8000-000000000001"}]},"streamSettings":{"network":"xhttp","security":"tls","xhttpSettings":{"mode":"stream-one"}}}],"outbounds":[{"tag":"wm-eu-only-block","protocol":"blackhole"},{"tag":"wm-exit-path-unit","protocol":"vless"},{"tag":"sentinel","protocol":"freedom"}],"routing":{"rules":[{"type":"field","inboundTag":["api"],"outboundTag":"api"},{"type":"field","inboundTag":["wm-route-unit"],"ruleTag":"wm-rule-unit","outboundTag":"wm-eu-only-block"}],"balancers":[{"tag":"unit-balancer","selector":["wm-exit-path-"]}]}}`)
+	o := newExecutionOwner(data, ExecutionIdentity{Generation: "00000000-0000-4000-8000-000000000002"}, nil)
+	if err := validateExecutionInputs(o.config); err != nil {
+		t.Fatalf("fixture admission: %v", err)
+	}
+	o.qualified = true
+	o.reason = "custody_attested"
+	return o
+}
+
+func fixtureRouting(o *executionOwner, target string) map[string]any {
+	doc, _ := executionDocument(executionJSON(o.config))
+	routing := doc["routing"].(map[string]any)
+	routing["rules"].([]any)[1].(map[string]any)["outboundTag"] = target
+	return routing
+}
+
+func TestExecutionEveryShippedMutatorInvalidatesBeforeEffectsAndAccountsSuccess(t *testing.T) {
+	cases := []struct {
+		name    string
+		payload func(*executionOwner) map[string]any
+		check   func(*testing.T, ExecutionSnapshot)
+	}{
+		{"AddInbound", func(o *executionOwner) map[string]any {
+			doc, _ := executionDocument(executionJSON(o.config))
+			ib := doc["inbounds"].([]any)[1].(map[string]any)
+			ib["tag"] = "extra"
+			return map[string]any{"object": ib}
+		}, func(t *testing.T, s ExecutionSnapshot) {
+			doc, _ := executionDocument(s.Config)
+			if len(doc["inbounds"].([]any)) != 3 {
+				t.Fatal("successful inbound not represented")
+			}
+		}},
+		{"DelInbound", func(*executionOwner) map[string]any { return map[string]any{"tag": "wm-route-unit"} }, func(t *testing.T, s ExecutionSnapshot) {
+			doc, _ := executionDocument(s.Config)
+			if len(doc["inbounds"].([]any)) != 1 {
+				t.Fatal("removed inbound retained")
+			}
+		}},
+		{"AddOutbound", func(*executionOwner) map[string]any {
+			return map[string]any{"object": map[string]any{"tag": "extra", "protocol": "blackhole"}}
+		}, func(t *testing.T, s ExecutionSnapshot) {
+			doc, _ := executionDocument(s.Config)
+			if len(doc["outbounds"].([]any)) != 4 {
+				t.Fatal("successful outbound not represented")
+			}
+		}},
+		{"DelOutbound", func(*executionOwner) map[string]any { return map[string]any{"tag": "sentinel"} }, func(t *testing.T, s ExecutionSnapshot) {
+			doc, _ := executionDocument(s.Config)
+			if len(doc["outbounds"].([]any)) != 2 {
+				t.Fatal("removed outbound retained")
+			}
+		}},
+		{"ApplyRoutingConfig", func(o *executionOwner) map[string]any {
+			return map[string]any{"routing": fixtureRouting(o, "wm-exit-path-unit")}
+		}, func(t *testing.T, s ExecutionSnapshot) {
+			if s.Transition == nil || s.Transition.FromEpoch != "0" || s.Transition.ToEpoch != "1" || s.Transition.RuleTag != "wm-rule-unit" {
+				t.Fatalf("selector receipt missing: %+v", s.Transition)
+			}
+		}},
+		{"SetBalancerTarget", func(*executionOwner) map[string]any {
+			return map[string]any{"tag": "unit-balancer", "target": "wm-exit-path-unit"}
+		}, func(t *testing.T, s ExecutionSnapshot) {
+			if s.Overrides["unit-balancer"] != "wm-exit-path-unit" {
+				t.Fatal("runtime override missing")
+			}
+		}},
+		{"AddUser", func(*executionOwner) map[string]any {
+			return map[string]any{"tag": "wm-route-unit", "protocol": "vless", "user": map[string]any{"email": "new@example.invalid", "id": "00000000-0000-4000-8000-000000000003"}}
+		}, func(t *testing.T, s ExecutionSnapshot) {
+			doc, _ := executionDocument(s.Config)
+			ib := doc["inbounds"].([]any)[1].(map[string]any)
+			if len(ib["settings"].(map[string]any)["clients"].([]any)) != 2 {
+				t.Fatal("added credential missing")
+			}
+		}},
+		{"RemoveUser", func(*executionOwner) map[string]any {
+			return map[string]any{"tag": "wm-route-unit", "email": "old@example.invalid"}
+		}, func(t *testing.T, s ExecutionSnapshot) {
+			doc, _ := executionDocument(s.Config)
+			ib := doc["inbounds"].([]any)[1].(map[string]any)
+			if len(ib["settings"].(map[string]any)["clients"].([]any)) != 0 {
+				t.Fatal("removed credential retained")
+			}
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			o := executionFixture(t)
+			beforeExecutionHash := o.snapshot("before").ExecutionSHA256
+			err := o.mutate(tc.name, tc.payload(o), nil, func() error {
+				if o.qualified || o.epoch != 1 || o.reason != "native_outcome_unknown" {
+					t.Fatal("native effect began before UNKNOWN")
+				}
+				return nil
+			})
+			if err != nil {
+				t.Fatalf("native call: %v", err)
+			}
+			s := o.snapshot("after")
+			if !s.Qualified || s.Reason != "custody_attested" || s.Epoch != "1" || len(s.Config) == 0 || s.ExecutionSHA256 == beforeExecutionHash {
+				t.Fatalf("successful effect not fully attested: %+v", s)
+			}
+			tc.check(t, s)
+		})
+	}
+}
+
+func TestExecutionABARejectsAnOldExpectedEpochDespiteEqualFinalJSON(t *testing.T) {
+	o := executionFixture(t)
+	initial := o.snapshot("initial")
+	for _, target := range []string{"wm-exit-path-unit", "wm-eu-only-block"} {
+		err := o.mutate("ApplyRoutingConfig", map[string]any{"routing": fixtureRouting(o, target)}, &ExecutionExpected{Generation: o.identity.Generation, Epoch: o.snapshot("current").Epoch}, func() error { return nil })
+		if err != nil {
+			t.Fatalf("selector transition: %v", err)
+		}
+	}
+	s := o.snapshot("returned")
+	if !s.Qualified || s.EffectiveSHA256 != initial.EffectiveSHA256 || s.Epoch != "2" {
+		t.Fatalf("ABA fixture: %+v", s)
+	}
+	called := false
+	err := o.mutate("ApplyRoutingConfig", map[string]any{"routing": fixtureRouting(o, "wm-exit-path-unit")}, &ExecutionExpected{Generation: o.identity.Generation, Epoch: initial.Epoch}, func() error { called = true; return nil })
+	if !errors.Is(err, ErrExecutionConflict) || called {
+		t.Fatalf("old epoch reached native effects: %v called=%v", err, called)
+	}
+}
+
+func TestExecutionSnapshotCannotExposeAQualifiedPrefixOfLostMutation(t *testing.T) {
+	o := executionFixture(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	mutationDone := make(chan error, 1)
+	go func() {
+		mutationDone <- o.mutate("DelInbound", map[string]any{"tag": "wm-route-unit"}, nil, func() error { close(entered); <-release; return errors.New("lost native response") })
+	}()
+	<-entered
+	result := make(chan ExecutionSnapshot, 1)
+	attempted := make(chan struct{})
+	go func() { close(attempted); result <- o.snapshot("concurrent") }()
+	<-attempted
+	select {
+	case s := <-result:
+		close(release)
+		t.Fatalf("snapshot interleaved with mutation: %+v", s)
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	if err := <-mutationDone; err == nil || err.Error() != "lost native response" {
+		t.Fatalf("mutation outcome %v", err)
+	}
+	s := <-result
+	if s.Qualified || s.Config != nil || s.EffectiveSHA256 != "" || s.ExecutionSHA256 != "" || s.Epoch != "1" {
+		t.Fatalf("qualified stale prefix: %+v", s)
+	}
+}
+
+func TestExecutionUnsupportedEffectsAndPersistenceFailureStayUnknown(t *testing.T) {
+	for _, kind := range []string{"RemoveRule", "AlterOutbound", "UnsupportedUser", "Persistence"} {
+		t.Run(kind, func(t *testing.T) {
