+		return err
+	}
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: executionSnapshotPath, Net: "unix"})
+	if err != nil {
+		return err
+	}
+	if err = os.Chmod(executionSnapshotPath, 0600); err != nil {
