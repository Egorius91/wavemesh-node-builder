+)
+
+func nativeSnapshot(t *testing.T) ExecutionSnapshot {
+	t.Helper()
+	c, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: executionSnapshotPath, Net: "unix"})
+	if err != nil {
+		t.Fatal("private snapshot dial failed")
+	}
+	defer c.Close()
+	cred, err := unixPeer(c)
+	if err != nil || cred.Uid != 0 || int(cred.Pid) != os.Getpid() {
+		t.Fatal("producer peer credentials mismatch")
+	}
+	nonce := make([]byte, 32)
+	if _, err = rand.Read(nonce); err != nil {
+		t.Fatal("challenge entropy unavailable")
+	}
+	challenge := hex.EncodeToString(nonce)
+	_ = c.SetDeadline(time.Now().Add(3 * time.Second))
+	_, err = c.Write(append(executionJSON(map[string]any{"schema_version": 3, "challenge": challenge}), '\n'))
+	if err != nil {
+		t.Fatal("private snapshot request failed")
+	}
+	line, err := bufio.NewReader(io.LimitReader(c, 4<<20)).ReadBytes('\n')
+	if err != nil {
+		t.Fatal("private snapshot response failed")
+	}
+	var s ExecutionSnapshot
+	d := json.NewDecoder(bytes.NewReader(line))
+	d.DisallowUnknownFields()
+	if d.Decode(&s) != nil || s.Challenge != challenge || s.SchemaVersion != 3 {
+		t.Fatal("snapshot response challenge or schema mismatch")
+	}
+	return s
+}
+
+func nativePort(t *testing.T) int {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal("fixture port unavailable")
+	}
+	p := l.Addr().(*net.TCPAddr).Port
+	l.Close()
+	return p
+}
+
+func nativeTLS(t *testing.T) map[string]any {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal("fixture key generation failed")
+	}
+	cert := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "prepared.invalid"}, DNSNames: []string{"prepared.invalid"}, NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	der, err := x509.CreateCertificate(rand.Reader, cert, cert, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal("fixture certificate generation failed")
+	}
+	secret, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal("fixture key encoding failed")
+	}
+	return map[string]any{"certificates": []any{map[string]any{"certificate": strings.Split(strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))), "\n"), "key": strings.Split(strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: secret}))), "\n"), "oneTimeLoading": true}}}
+}
+
+func nativeFixtureConfig(t *testing.T) (*Config, int) {
+	t.Helper()
+	o := executionFixture(t)
+	doc := o.config
+	apiPort := nativePort(t)
+	ibs := doc["inbounds"].([]any)
+	ibs[0].(map[string]any)["port"] = apiPort
+	entry := ibs[1].(map[string]any)
+	entry["port"] = nativePort(t)
+	entry["listen"] = "127.0.0.1"
+	entry["settings"].(map[string]any)["decryption"] = "none"
+	stream := entry["streamSettings"].(map[string]any)
+	stream["tlsSettings"] = nativeTLS(t)
+	stream["xhttpSettings"].(map[string]any)["path"] = "/native-unit"
+	outbounds := doc["outbounds"].([]any)
+	path := outbounds[1].(map[string]any)
+	path["settings"] = map[string]any{"vnext": []any{map[string]any{"address": "127.0.0.1", "port": nativePort(t), "users": []any{map[string]any{"id": "00000000-0000-4000-8000-000000000004", "encryption": "none"}}}}}
+	path["streamSettings"] = map[string]any{"network": "xhttp", "security": "tls", "tlsSettings": map[string]any{"serverName": "prepared.invalid"}, "xhttpSettings": map[string]any{"path": "/native-unit", "mode": "stream-one"}}
+	doc["log"] = map[string]any{"access": "none", "error": "none", "loglevel": "none"}
+	doc["stats"] = map[string]any{}
+	doc["policy"] = map[string]any{"system": map[string]any{"statsInboundUplink": true, "statsInboundDownlink": true}}
+	routing := doc["routing"].(map[string]any)
+	routing["rules"] = append(routing["rules"].([]any), map[string]any{"type": "field", "inboundTag": []any{"sentinel-inbound"}, "outboundTag": "sentinel"})
+	var cfg Config
+	if json.Unmarshal(executionJSON(doc), &cfg) != nil {
+		t.Fatal("fixture config encoding failed")
+	}
+	return &cfg, apiPort
+}
+
+func TestExecutionNativeUnprivilegedHelper(t *testing.T) {
+	if os.Getenv("PR4_UNPRIVILEGED_HELPER") != "1" {
+		t.Skip("invoked only by the isolated native custody test")
+	}
+	if os.Geteuid() != 65534 {
+		t.Fatal("helper did not drop Unix identity")
+	}
+	for _, path := range []string{executionCorePath, executionSnapshotPath} {
+		c, err := net.Dial("unix", path)
+		if c != nil {
+			c.Close()
+		}
+		if !errors.Is(err, syscall.EACCES) {
+			t.Fatal("unprivileged native access was not denied by filesystem custody")
+		}
+	}
+}
+
+func TestExecutionNativeImmutableInputUDSAllMutatorsAndLostOutcome(t *testing.T) {
+	binary := os.Getenv("XRAY_E2E_BINARY")
+	if binary == "" {
+		t.Skip("requires exact stock core and an exclusively admitted Linux fixture")
+	}
+	if os.Geteuid() != 0 {
+		t.Fatal("native custody fixture requires its admitted root guest")
+	}
+	for _, path := range []string{executionCorePath, executionSnapshotPath} {
+		if _, err := os.Lstat(path); !os.IsNotExist(err) {
+			t.Fatal("native fixture path is already occupied")
+		}
+	}
+	bytesCore, err := os.ReadFile(binary)
+	if err != nil {
+		t.Fatal("stock core unavailable")
+	}
+	h := sha256.Sum256(bytesCore)
+	if hex.EncodeToString(h[:]) != stockCoreSHA256 {
+		t.Fatal("stock core hash mismatch")
+	}
+	binDir := t.TempDir()
+	if os.WriteFile(filepath.Join(binDir, GetBinaryName()), bytesCore, 0755) != nil {
+		t.Fatal("private core copy failed")
+	}
+	t.Setenv("XUI_BIN_FOLDER", binDir)
+	t.Setenv("XUI_LOG_FOLDER", t.TempDir())
+	t.Setenv("XUI_PREPARED_ATTESTATION", "1")
+	cfg, unusedTCP := nativeFixtureConfig(t)
+	p := NewProcess(cfg)
+	if err = p.Start(); err != nil {
+		result := p.GetResult()
+		if len(result) > 1024 || strings.Contains(result, `"inbounds"`) || strings.Contains(result, `"key"`) || strings.Contains(result, "-----") {
+			result = "private diagnostic suppressed"
+		}
+		t.Fatalf("managed cold launch failed (%T): %v; child exit: %v; child result: %s", err, err, p.GetErr(), result)
+	}
+	t.Cleanup(func() {
+		if p.IsRunning() {
+			if e := p.Stop(); e != nil {
+				t.Error("owned core cleanup failed")
+			}
+		}
+	})
+	s := nativeSnapshot(t)
+	p.execution.mu.Lock()
+	firstExecutable := p.execution.executable
+	p.execution.mu.Unlock()
+	if !s.Qualified || s.Identity.CoreSHA256 != stockCoreSHA256 || s.Identity.PID <= 0 || s.Identity.ProducerPID != os.Getpid() || s.Epoch != "0" {
+		t.Fatal("cold generation is not custody attested")
+	}
+	for _, path := range []string{executionCorePath, executionSnapshotPath} {
+		var st unix.Stat_t
+		if unix.Lstat(path, &st) != nil || st.Uid != 0 || st.Mode&0777 != 0600 {
+			t.Fatal("private socket permissions mismatch")
+		}
+	}
+	var parent unix.Stat_t
+	if unix.Lstat(executionDirectory, &parent) != nil || parent.Uid != 0 || parent.Mode&0777 != 0700 {
+		t.Fatal("private parent permissions mismatch")
+	}
+	if c, e := net.DialTimeout("tcp", net.JoinHostPort("127.0.0.1", strconv.Itoa(unusedTCP)), 100*time.Millisecond); e == nil {
+		c.Close()
+		t.Fatal("managed control leaked to TCP")
+	}
+	var consumedStat unix.Stat_t
+	for _, fd := range []string{"0", "3"} {
+		consumedPath := filepath.Join("/proc", strconv.Itoa(s.Identity.PID), "fd", fd)
+		f, err := os.OpenFile(consumedPath, os.O_RDWR, 0)
+		if err != nil {
+			t.Fatal("consumed sealed descriptor unavailable")
+		}
+		var st unix.Stat_t
+		if unix.Fstat(int(f.Fd()), &st) != nil || (fd == "3" && (st.Dev != consumedStat.Dev || st.Ino != consumedStat.Ino)) {
+			f.Close()
+			t.Fatal("stdin and retained config descriptor differ")
+		}
+		consumedStat = st
+		seals, err := unix.FcntlInt(f.Fd(), unix.F_GET_SEALS, 0)
+		if err != nil || seals&(unix.F_SEAL_WRITE|unix.F_SEAL_GROW|unix.F_SEAL_SHRINK|unix.F_SEAL_SEAL) != (unix.F_SEAL_WRITE|unix.F_SEAL_GROW|unix.F_SEAL_SHRINK|unix.F_SEAL_SEAL) {
+			f.Close()
+			t.Fatal("consumed input lacks immutable seals")
+		}
+		if _, err = f.WriteAt([]byte("x"), 0); !errors.Is(err, syscall.EPERM) {
+			f.Close()
+			t.Fatal("consumed bytes remained writable")
+		}
+		f.Close()
+		if actual, err := hashFile(consumedPath); err != nil || actual != s.Identity.ConsumedSHA256 {
+			t.Fatal("consumed generation hash mismatch")
+		}
+	}
+	self, e := os.ReadFile(os.Args[0])
+	if e != nil {
+		t.Fatal("unprivileged helper unavailable")
+	}
+	helper, e := os.CreateTemp("/tmp", "pr4-unprivileged-*")
+	if e != nil {
+		t.Fatal("helper path unavailable")
+	}
+	helperPath := helper.Name()
+	t.Cleanup(func() { os.Remove(helperPath) })
+	_, e = helper.Write(self)
+	helper.Close()
+	if e != nil || os.Chmod(helperPath, 0755) != nil {
+		t.Fatal("helper preparation failed")
+	}
+	command := exec.Command(helperPath, "-test.run=^TestExecutionNativeUnprivilegedHelper$", "-test.count=1")
+	command.Env = []string{"PR4_UNPRIVILEGED_HELPER=1"}
+	command.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: 65534, Gid: 65534}}
+	if _, e = command.CombinedOutput(); e != nil {
+		t.Fatal("unprivileged direct writer exclusion failed")
+	}
+	api := &XrayAPI{}
+	if api.InitEndpoint(p.GetAPIEndpoint()) != nil {
+		t.Fatal("producer native dial failed")
+	}
+	defer api.Close()
+	user := map[string]any{"id": "00000000-0000-4000-8000-000000000005", "email": "new@example.invalid"}
+	if api.AddUser("vless", "wm-route-unit", user) != nil || api.RemoveUser("wm-route-unit", "new@example.invalid") != nil {
+		t.Fatal("native user mutation failed")
+	}
+	var beforeDoc map[string]any
+	if json.Unmarshal(nativeSnapshot(t).Config, &beforeDoc) != nil {
+		t.Fatal("native execution document missing")
+	}
+	extra := beforeDoc["inbounds"].([]any)[1].(map[string]any)
+	extra["tag"] = "extra-native"
+	extra["port"] = nativePort(t)
+	if api.AddInbound(executionJSON(extra)) != nil || api.DelInbound("extra-native") != nil {
+		t.Fatal("native inbound mutation failed")
+	}
+	if api.AddOutbound([]byte(`{"tag":"extra-native","protocol":"blackhole"}`)) != nil || api.DelOutbound("extra-native") != nil {
+		t.Fatal("native outbound mutation failed")
+	}
+	if api.SetBalancerTarget("unit-balancer", "wm-exit-path-unit") != nil {
+		t.Fatal("native override failed")
+	}
+	if nativeSnapshot(t).Overrides["unit-balancer"] != "wm-exit-path-unit" {
+		t.Fatal("native override was omitted")
+	}
+	if api.SetBalancerTarget("unit-balancer", "") != nil {
+		t.Fatal("native override clear failed")
+	}
+	for range 16 {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		_, e = (*api.StatsServiceClient).GetSysStats(ctx, &statsService.SysStatsRequest{})
+		cancel()
+		if e != nil {
+			t.Fatal("native stats reader failed")
+		}
+	}
+	readCounter := func() int64 {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		r, e := (*api.StatsServiceClient).GetStats(ctx, &statsService.GetStatsRequest{Name: "inbound>>>api>>>traffic>>>uplink", Reset_: false})
+		if e != nil || r.Stat == nil {
+			t.Fatal("native monotonic counter unavailable")
+		}
+		return r.Stat.Value
+	}
+	beforeCounter := readCounter()
+	before := nativeSnapshot(t)
+	routing := fixtureRouting(p.execution, "wm-exit-path-unit")
+	if api.CompareAndApplyRouting(executionJSON(routing), ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch}) != nil {
+		t.Fatal("native selector CAS failed")
+	}
+	after := nativeSnapshot(t)
+	if !after.Qualified || after.Transition == nil || after.Identity.Generation != before.Identity.Generation {
+		t.Fatal("native selector continuity was not proved")
+	}
+	if beforeCounter <= 0 || readCounter() < beforeCounter {
+		t.Fatal("selector changed or reset native counters")
+	}
+	for _, inbound := range []string{"wm-route-unit", "sentinel-inbound"} {
+		result, e := api.TestRoute(RouteTestRequest{InboundTag: inbound, IP: "1.1.1.1", Port: 443})
+		expected := "wm-exit-path-unit"
+		if inbound == "sentinel-inbound" {
+			expected = "sentinel"
+		}
+		if e != nil || result.OutboundTag != expected {
+			t.Fatal("native target or sentinel routing changed")
+		}
+	}
+	if e = api.CompareAndApplyRouting(executionJSON(fixtureRouting(p.execution, "wm-eu-only-block")), ExecutionExpected{Generation: before.Identity.Generation, Epoch: before.Epoch}); !errors.Is(e, ErrExecutionConflict) {
+		t.Fatal("stale CAS reached native routing")
+	}
+	duplicate, _ := json.Marshal(cfg.InboundConfigs[1])
+	if api.AddInbound(duplicate) == nil {
+		t.Fatal("duplicate native inbound unexpectedly succeeded")
+	}
+	unknown := nativeSnapshot(t)
+	if unknown.Qualified || unknown.Config != nil || unknown.EffectiveSHA256 != "" {
+		t.Fatal("lost or failed effect retained qualified execution")
+	}
+	p.SetConfig(cfg)
+	if nativeSnapshot(t).Qualified {
+		t.Fatal("desired shadow resealed execution")
+	}
+	oldGeneration := s.Identity.Generation
+	if p.Stop() != nil || p.IsRunning() {
+		t.Fatal("first core did not close")
+	}
+	if firstExecutable == nil {
+		t.Fatal("running generation did not retain executable custody")
+	}
+	if _, err = firstExecutable.Stat(); !errors.Is(err, os.ErrClosed) {
+		t.Fatal("stopped generation retained its executable descriptor")
+	}
+	api.Close()
+	p = NewProcess(cfg)
+	if p.Start() != nil {
+		t.Fatal("safe new cold generation failed")
+	}
+	fresh := nativeSnapshot(t)
+	if !fresh.Qualified || fresh.Identity.Generation == oldGeneration || fresh.Epoch != "0" {
+		t.Fatal("new cold generation reused old history")
+	}
+	freshAPI := &XrayAPI{}
+	if freshAPI.InitEndpoint(p.GetAPIEndpoint()) != nil {
+		t.Fatal("fresh-generation native dial failed")
+	}
+	defer freshAPI.Close()
+	for _, target := range []string{"api", "missing-outbound"} {
+		if err := freshAPI.SetBalancerTarget("unit-balancer", target); !errors.Is(err, ErrExecutionControlBoundary) {
+			t.Fatal("unsafe native override was not refused before effects")
+		}
+		current := nativeSnapshot(t)
+		actual, err := freshAPI.GetBalancerInfo("unit-balancer")
+		if err != nil || actual.Override != "" || !current.Qualified || current.Identity.Generation != fresh.Identity.Generation || current.Epoch != fresh.Epoch || current.ExecutionSHA256 != fresh.ExecutionSHA256 {
+			t.Fatal("refused override changed actual core or the previous safe attestation")
+		}
+	}
+	for _, target := range []string{"wm-exit-path-unit", ""} {
+		if freshAPI.SetBalancerTarget("unit-balancer", target) != nil {
+			t.Fatal("supported fresh override or clear failed")
+		}
+		actual, err := freshAPI.GetBalancerInfo("unit-balancer")
+		current := nativeSnapshot(t)
+		if err != nil || actual.Override != target || !current.Qualified || current.Overrides["unit-balancer"] != target {
+			t.Fatal("actual override and attested override differ")
+		}
+	}
+	if current := nativeSnapshot(t); current.ExecutionSHA256 != fresh.ExecutionSHA256 || current.Epoch != "2" || current.Identity.Generation != fresh.Identity.Generation {
+		t.Fatal("actual clear changed configuration or reused an epoch")
+	}
+	if freshAPI.SetBalancerTarget("unit-balancer", "wm-exit-path-unit") != nil || freshAPI.DelOutbound("wm-exit-path-unit") != nil {
+		t.Fatal("referenced native target removal failed")
+	}
+	removed := nativeSnapshot(t)
+	if removed.Qualified || removed.Config != nil || removed.ExecutionSHA256 != "" || removed.Epoch != "4" {
+		t.Fatal("actual target removal retained qualified execution")
+	}
+	if freshAPI.SetBalancerTarget("unit-balancer", "") != nil {
+		t.Fatal("unknown-state native override clear failed")
+	}
+	actual, err := freshAPI.GetBalancerInfo("unit-balancer")
+	if err != nil || actual.Override != "" {
+		t.Fatal("actual unknown-state override was not cleared")
+	}
+	p.SetConfig(cfg)
+	if current := nativeSnapshot(t); current.Qualified || current.Config != nil || current.Epoch != "5" {
+		t.Fatal("native clear or SetConfig resealed a removed target")
+	}
+}
