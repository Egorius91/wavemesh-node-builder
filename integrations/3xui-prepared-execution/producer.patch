index 00000000..14885efa
--- /dev/null
+++ b/internal/xray/execution_identity_linux_test.go
@@ -0,0 +1,58 @@
+//go:build linux
+
+package xray
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestExecutionNativeSealedExecutableIdentity(t *testing.T) {
+	f, err := sealedInput("identity-unit", []byte("same immutable bytes"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	path := "/proc/self/fd/" + strconv.Itoa(int(f.Fd()))
+	if err = verifySealedExecutable(path, f); err != nil {
+		t.Fatal("same sealed object was refused")
+	}
+	other, err := sealedInput("identity-unit", []byte("same immutable bytes"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer other.Close()
+	if verifySealedExecutable("/proc/self/fd/"+strconv.Itoa(int(other.Fd())), f) == nil {
+		t.Fatal("same-content replacement inode was admitted")
+	}
+	plain, err := os.CreateTemp(t.TempDir(), "unsealed")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer plain.Close()
+	if verifySealedExecutable(plain.Name(), plain) == nil || verifySealedExecutable(filepath.Join(t.TempDir(), "missing"), f) == nil {
+		t.Fatal("unsealed or missing actual object was admitted")
+	}
+	fd, err := unix.MemfdCreate("partial-seals", unix.MFD_CLOEXEC|unix.MFD_ALLOW_SEALING)
+	if err != nil {
+		t.Fatal(err)
+	}
+	partial := os.NewFile(uintptr(fd), "partial-seals")
+	defer partial.Close()
+	if _, err = unix.FcntlInt(partial.Fd(), unix.F_ADD_SEALS, unix.F_SEAL_WRITE); err != nil {
+		t.Fatal(err)
+	}
+	if verifySealedExecutable("/proc/self/fd/"+strconv.Itoa(fd), partial) == nil {
+		t.Fatal("incomplete immutable seals were admitted")
+	}
+	if err = f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if verifySealedExecutable(path, f) == nil || verifySealedExecutable(path, nil) == nil {
+		t.Fatal("closed or missing expected descriptor was admitted")
+	}
+}
