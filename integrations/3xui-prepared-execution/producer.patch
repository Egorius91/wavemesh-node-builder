diff --git a/internal/web/controller/xray_execution.go b/internal/web/controller/xray_execution.go
new file mode 100644
index 00000000..98a912a6
--- /dev/null
+++ b/internal/web/controller/xray_execution.go
@@ -0,0 +1,175 @@
+package controller
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"net/http"
+	"regexp"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/gin-gonic/gin"
+	"github.com/mhsanaei/3x-ui/v3/internal/web/service"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+const executionRequestLimit = 4 << 20
+const executionDiagnosticHeader = "X-WaveMesh-Execution-Diagnostic"
+
+var executionRequestID = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$`)
+var executionRequestHash = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var executionRequestUUID = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var errExecutionRequest = errors.New("invalid execution request")
+
+type executionSelectorRequest struct {
+	SchemaVersion *int   `json:"schema_version"`
+	TransactionID string `json:"transaction_id"`
+	IntentSHA256  string `json:"intent_sha256"`
+	Expected      *struct {
+		Generation      string `json:"generation"`
+		Epoch           string `json:"epoch"`
+		EffectiveSHA256 string `json:"effective_config_sha256"`
+	} `json:"expected"`
+	TemplateBefore string `json:"template_before"`
+	RuleTag        string `json:"rule_tag"`
+	Target         string `json:"target"`
+}
+
+// encoding/json's struct decoder permits duplicate and case-folded keys. Check
+// tokens and exact object keys before typed decoding at this request boundary.
+func executionJSONValue(d *json.Decoder, depth int) error {
+	if depth > 32 {
+		return errExecutionRequest
+	}
+	token, err := d.Token()
+	if err != nil {
+		return errExecutionRequest
+	}
+	if delim, ok := token.(json.Delim); ok {
+		switch delim {
+		case '{':
+			seen := map[string]bool{}
+			for d.More() {
+				key, err := d.Token()
+				name, ok := key.(string)
+				if err != nil || !ok || seen[name] {
+					return errExecutionRequest
+				}
+				seen[name] = true
+				if err := executionJSONValue(d, depth+1); err != nil {
+					return err
+				}
+			}
+		case '[':
+			for d.More() {
+				if err := executionJSONValue(d, depth+1); err != nil {
+					return err
+				}
+			}
+		default:
+			return errExecutionRequest
+		}
+		if _, err := d.Token(); err != nil {
+			return errExecutionRequest
+		}
+	}
+	return nil
+}
+
+func executionStrictObject(raw []byte) error {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) == 0 || raw[0] != '{' || !utf8.Valid(raw) {
+		return errExecutionRequest
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.UseNumber()
+	if err := executionJSONValue(d, 0); err != nil {
+		return err
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return errExecutionRequest
+	}
+	return nil
+}
+
+func executionExactKeys(raw []byte, names ...string) bool {
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(raw, &fields) != nil || len(fields) != len(names) {
+		return false
+	}
+	for _, name := range names {
+		if _, ok := fields[name]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+func decodeExecutionSelector(body io.Reader) (executionSelectorRequest, error) {
+	var request executionSelectorRequest
+	raw, err := io.ReadAll(io.LimitReader(body, executionRequestLimit+1))
+	if err != nil || len(raw) > executionRequestLimit || executionStrictObject(raw) != nil ||
+		!executionExactKeys(raw, "schema_version", "transaction_id", "intent_sha256", "expected", "template_before", "rule_tag", "target") {
+		return request, errExecutionRequest
+	}
+	var fields map[string]json.RawMessage
+	_ = json.Unmarshal(raw, &fields)
+	if !executionExactKeys(fields["expected"], "generation", "epoch", "effective_config_sha256") || json.Unmarshal(raw, &request) != nil {
+		return request, errExecutionRequest
+	}
+	if request.SchemaVersion == nil || *request.SchemaVersion != 1 || request.Expected == nil ||
+		!executionRequestID.MatchString(request.TransactionID) || !executionRequestHash.MatchString(request.IntentSHA256) ||
+		!executionRequestUUID.MatchString(request.Expected.Generation) || !executionRequestHash.MatchString(request.Expected.EffectiveSHA256) ||
+		!executionRequestID.MatchString(request.RuleTag) || !strings.HasPrefix(request.RuleTag, "wm-rule-") || len(request.RuleTag) <= len("wm-rule-") ||
+		!executionRequestID.MatchString(request.Target) || !(request.Target == "wm-eu-only-block" || strings.HasPrefix(request.Target, "wm-exit-path-") && len(request.Target) > len("wm-exit-path-")) ||
+		executionStrictObject([]byte(request.TemplateBefore)) != nil {
+		return request, errExecutionRequest
+	}
+	epoch, err := strconv.ParseUint(request.Expected.Epoch, 10, 64)
+	if err != nil || epoch == ^uint64(0) || strconv.FormatUint(epoch, 10) != request.Expected.Epoch {
+		return request, errExecutionRequest
+	}
+	return request, nil
+}
+
+func (a *XraySettingController) executionSelector(c *gin.Context) {
+	serveExecutionSelector(c, a.XrayService.ApplyExecutionSelectorContext)
+}
+
+func serveExecutionSelector(c *gin.Context, apply func(context.Context, xray.ExecutionExpected, string, string, string) (service.ExecutionPersistenceResult, error)) {
+	refuse := func(status int, diagnostic string) {
+		c.Header(executionDiagnosticHeader, diagnostic)
+		c.JSON(status, gin.H{"diagnostic": diagnostic})
+	}
+	if !xray.PreparedExecutionEnabled() {
+		refuse(http.StatusServiceUnavailable, "PREPARED_EXECUTION_DISABLED")
+		return
+	}
+	media, _, err := mime.ParseMediaType(c.GetHeader("Content-Type"))
+	if err != nil || media != "application/json" || c.Request.Context().Err() != nil {
+		refuse(http.StatusBadRequest, "INVALID_REQUEST")
+		return
+	}
+	request, err := decodeExecutionSelector(c.Request.Body)
+	if err != nil {
+		refuse(http.StatusBadRequest, "INVALID_REQUEST")
+		return
+	}
+	expected := xray.ExecutionExpected{Generation: request.Expected.Generation, Epoch: request.Expected.Epoch, EffectiveSHA256: request.Expected.EffectiveSHA256}
+	result, err := apply(c.Request.Context(), expected, request.TemplateBefore, request.RuleTag, request.Target)
+	status, diagnostic := http.StatusConflict, "OUTCOME_UNPROVEN"
+	if err == nil && result.KnownCommit {
+		status, diagnostic = http.StatusOK, "COMMITTED"
+	} else if err == nil && result.NoOp {
+		status, diagnostic = http.StatusOK, "NO_OP"
+	}
+	// The body is exactly the private journal's existing owner-result shape.
+	// Fixed diagnostics are headers, never raw service errors or config payload.
+	c.Header(executionDiagnosticHeader, diagnostic)
+	c.JSON(status, gin.H{"schema_version": 1, "transaction_id": request.TransactionID, "intent_sha256": request.IntentSHA256, "outcome": result})
+}
