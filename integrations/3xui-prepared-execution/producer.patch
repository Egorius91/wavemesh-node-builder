+func TestExecutionPersistencePartialFailuresDoNotAdvanceDesiredShadow(t *testing.T) {
+	t.Setenv("XUI_DB_TYPE", "sqlite")
+	dbtest.InitDB(t, filepath.Join(t.TempDir(), "synthetic.db"))
+	db := database.GetDB()
+	if err := db.Where("key = ?", "xrayTemplateConfig").Delete(&model.Setting{}).Error; err != nil {
+		t.Fatal(err)
+	}
+	row := model.Setting{Key: "xrayTemplateConfig", Value: "before"}
+	if err := db.Create(&row).Error; err != nil {
+		t.Fatal(err)
+	}
+	setting := &XraySettingService{}
+	old := &xray.Config{RouterConfig: json_util.RawMessage(`{"rules":[]}`)}
+	desired := &xray.Config{RouterConfig: json_util.RawMessage(`{"rules":[{"outboundTag":"wm-exit-path-unit"}]}`)}
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.json")
+	p := xray.NewTestProcess(old, path)
+	if err := os.WriteFile(path, []byte("sentinel"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(&row).Update("value", "newer").Error; err != nil {
+		t.Fatal(err)
+	}
+	before := model.Setting{Id: row.Id, Key: row.Key, Value: "before"}
+	var result ExecutionPersistenceResult
+	err := persistExecutionSelector(setting, p, &before, "after", desired, &result)
+	data, _ := os.ReadFile(path)
+	if !errors.Is(err, errExecutionTemplateConflict) || result.TemplatePersisted || result.ConfigPersisted || string(data) != "sentinel" || p.GetConfig() != old {
+		t.Fatal("DB conflict wrote file or shadow")
+	}
+	before.Value = "newer"
+	// A file error after DB success is partial/unknown, never implicit rollback.
+	p = xray.NewTestProcess(old, filepath.Join(dir, "absent", "config.json"))
+	err = persistExecutionSelector(setting, p, &before, "after", desired, &result)
+	stored, readErr := setting.executionTemplate()
+	if err == nil || readErr != nil || stored.Value != "after" || !result.TemplatePersisted || result.ConfigPersisted || result.ProcessConfigSHA256 != "" || result.KnownCommit || p.GetConfig() != old {
+		t.Fatal("partial persistence was hidden or compensated")
+	}
+	p = xray.NewTestProcess(old, path)
+	result = ExecutionPersistenceResult{}
+	if err := persistExecutionSelector(setting, p, stored, "final", desired, &result); err != nil {
+		t.Fatal(err)
+	}
+	if !result.TemplatePersisted || !result.ConfigPersisted || result.KnownCommit || !p.GetConfig().Equals(desired) {
+		t.Fatal("persistence alone claimed native commit or lost desired bytes")
+	}
+	postBytes, readErr := os.ReadFile(path)
+	if readErr != nil || result.ProcessConfigSHA256 != fmt.Sprintf("%x", sha256.Sum256(postBytes)) {
+		t.Fatal("service did not retain exact owner process postimage hash")
+	}
+	if err := db.Migrator().DropTable(&model.Setting{}); err != nil {
+		t.Fatal(err)
+	}
+	result = ExecutionPersistenceResult{}
+	if err := persistExecutionSelector(setting, p, stored, "bad", desired, &result); err == nil || result.TemplatePersisted || result.ConfigPersisted {
+		t.Fatal("DB error accepted")
+	}
+}
