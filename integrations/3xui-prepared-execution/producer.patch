+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+func TestExecutionContextCanceledServiceWaiterStopsBeforeProcessOrStorage(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	lock.Lock()
+	go func() {
+		result, err := (&XrayService{}).ApplyExecutionSelectorContext(ctx, xray.ExecutionExpected{}, "", "wm-rule-unit", "wm-eu-only-block")
+		if result != (ExecutionPersistenceResult{}) {
+			done <- errors.New("canceled waiter reported effects")
+			return
+		}
+		done <- err
+	}()
+	select {
+	case <-done:
+		lock.Unlock()
+		t.Fatal("service ownership bypassed")
+	case <-time.After(20 * time.Millisecond):
+	}
+	cancel()
+	lock.Unlock()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled waiter reached process/storage path: %v", err)
+	}
+}
