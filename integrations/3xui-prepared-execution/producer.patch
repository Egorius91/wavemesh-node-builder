@@ -0,0 +1,51 @@
+package xray
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"testing"
+	"time"
+)
+
+func TestExecutionExitedChildClosesOnlyItsCapturedGeneration(t *testing.T) {
+	old, current := executionFixture(t), executionFixture(t)
+	oldFile, err := os.CreateTemp(t.TempDir(), "old")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer oldFile.Close()
+	currentFile, err := os.CreateTemp(t.TempDir(), "current")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer currentFile.Close()
+	old.executable, current.executable = oldFile, currentFile
+	p := newProcess(nil)
+	p.execution = old
+	cmd := exec.Command(os.Args[0], "-test.run=^TestMutationAuditHelper$", "--", "block")
+	cmd.Env = append(os.Environ(), "XRAY_MUT_HELPER=1")
+	if err = p.startCommand(cmd); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if p.IsRunning() {
+			p.intentionalStop.Store(true)
+			_ = cmd.Process.Kill()
+			_ = p.waitForExit(5 * time.Second)
+		}
+	})
+	p.mu.Lock()
+	p.execution = current
+	p.mu.Unlock()
+	p.intentionalStop.Store(true)
+	if cmd.Process.Kill() != nil || p.waitForExit(5*time.Second) != nil {
+		t.Fatal("owned child did not finish")
+	}
+	if _, err = oldFile.ReadAt(make([]byte, 1), 0); !errors.Is(err, os.ErrClosed) || old.snapshot("").Qualified {
+		t.Fatal("exited generation retained an open qualified executable")
+	}
+	if _, err = currentFile.Stat(); err != nil || !current.snapshot("").Qualified {
+		t.Fatal("old cleanup closed or invalidated the newer generation")
+	}
+}
diff --git a/internal/xray/execution_linux.go b/internal/xray/execution_linux.go
new file mode 100644
index 00000000..fbde8034
--- /dev/null
+++ b/internal/xray/execution_linux.go
@@ -0,0 +1,398 @@
+//go:build linux
+
+package xray
+
+import (
+	"bufio"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/google/uuid"
+	statsService "github.com/xtls/xray-core/app/stats/command"
+	"golang.org/x/sys/unix"
+	"google.golang.org/grpc"
+)
+
+const executionDirectory = "/run/wavemesh-xray"
+const executionCorePath = executionDirectory + "/core.sock"
+const executionSnapshotPath = executionDirectory + "/snapshot.sock"
+
+func hashFile(path string) (string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	h := sha256.New()
+	if _, err = io.Copy(h, f); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func sealedInput(name string, data []byte) (*os.File, error) {
+	fd, err := unix.MemfdCreate(name, unix.MFD_CLOEXEC|unix.MFD_ALLOW_SEALING)
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), name)
+	if _, err = f.Write(data); err != nil {
+		f.Close()
+		return nil, err
+	}
+	if _, err = f.Seek(0, io.SeekStart); err != nil {
+		f.Close()
+		return nil, err
+	}
+	seals := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	if _, err = unix.FcntlInt(f.Fd(), unix.F_ADD_SEALS, seals); err != nil {
+		f.Close()
+		return nil, err
+	}
+	got, err := unix.FcntlInt(f.Fd(), unix.F_GET_SEALS, 0)
+	if err != nil || got != seals {
+		f.Close()
+		return nil, errors.New("sealed input unavailable")
+	}
+	return f, nil
+}
+
+func verifySealedExecutable(path string, expected *os.File) error {
+	if expected == nil {
+		return errors.New("sealed executable custody unavailable")
+	}
+	want, err := expected.Stat()
+	if err != nil {
+		return err
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	actual, err := f.Stat()
+	if err != nil || !os.SameFile(want, actual) {
+		return errors.New("executing sealed object changed")
+	}
+	seals, err := unix.FcntlInt(f.Fd(), unix.F_GET_SEALS, 0)
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	if err != nil || seals&required != required {
+		return errors.New("executable immutable seals unavailable")
+	}
+	return nil
+}
+
+func procStartTicks(pid int) (string, error) {
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return "", err
+	}
+	i := strings.LastIndexByte(string(data), ')')
+	if i < 0 {
+		return "", errors.New("invalid process stat")
+	}
+	fields := strings.Fields(string(data[i+1:]))
+	if len(fields) < 20 {
+		return "", errors.New("short process stat")
+	}
+	if fields[0] == "Z" || fields[0] == "X" {
+		return "", errors.New("process exited")
+	}
+	return fields[19], nil
+}
+
+func privateExecutionDirectory() error {
+	if os.Geteuid() != 0 {
+		return errors.New("managed execution requires existing root service custody")
+	}
+	if err := os.Mkdir(executionDirectory, 0700); err != nil && !os.IsExist(err) {
+		return err
+	}
+	st, err := os.Lstat(executionDirectory)
+	if err != nil {
+		return err
+	}
+	var u unix.Stat_t
+	if err = unix.Lstat(executionDirectory, &u); err != nil {
+		return err
+	}
+	if !st.IsDir() || st.Mode()&os.ModeSymlink != 0 || st.Mode().Perm() != 0700 || u.Uid != 0 {
+		return errors.New("unsafe execution directory")
+	}
+	return nil
+}
+
+func (p *process) startManagedExecution() (err error) {
+	if p.configPath != "" {
+		return errors.New("managed attestation is unavailable on test processes")
+	}
+	if err = privateExecutionDirectory(); err != nil {
+		return err
+	}
+	for _, path := range []string{executionCorePath, executionSnapshotPath} {
+		if _, e := os.Lstat(path); !os.IsNotExist(e) {
+			return errors.New("execution socket path already occupied")
+		}
+	}
+	p.mu.RLock()
+	data, err := json.Marshal(p.config)
+	p.mu.RUnlock()
+	if err != nil {
+		return err
+	}
+	doc, err := executionDocument(data)
+	if err != nil {
+		return err
+	}
+	if err = validateExecutionInputs(doc); err != nil {
+		return err
+	}
+	if err = initializePreparedDeny(doc); err != nil {
+		return err
+	}
+	ibs, _ := doc["inbounds"].([]any)
+	apiFound := false
+	for _, v := range ibs {
+		ib := v.(map[string]any)
+		if ib["tag"] == "api" {
+			if apiFound {
+				return errors.New("duplicate native control inbound")
+			}
+			apiFound = true
+			ib["listen"] = executionCorePath + ",0600"
+			delete(ib, "port")
+		}
+	}
+	if !apiFound {
+		return errors.New("native control inbound missing")
+	}
+	consumed := executionJSON(doc)
+	if len(consumed) > 4<<20 {
+		return errors.New("execution configuration exceeds private snapshot bound")
+	}
+	configFD, err := sealedInput("wavemesh-consumed-config", consumed)
+	if err != nil {
+		return err
+	}
+	defer configFD.Close()
+	coreBytes, err := os.ReadFile(GetBinaryPath())
+	if err != nil {
+		return err
+	}
+	h := sha256.Sum256(coreBytes)
+	if hex.EncodeToString(h[:]) != stockCoreSHA256 {
+		return errors.New("stock core hash mismatch")
+	}
+	coreFD, err := sealedInput("wavemesh-stock-core", coreBytes)
+	if err != nil {
+		return err
+	}
+	identityOwned := false
+	defer func() {
+		if !identityOwned {
+			_ = coreFD.Close()
+		}
+	}()
+	if err = coreFD.Chmod(0500); err != nil {
+		return err
+	}
+	boot, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return err
+	}
+	producerHash, err := hashFile("/proc/self/exe")
+	if err != nil {
+		return err
+	}
+	producerTicks, err := procStartTicks(os.Getpid())
+	if err != nil {
+		return err
+	}
+	consumedHash := sha256.Sum256(consumed)
+	id := ExecutionIdentity{Generation: uuid.NewString(), BootID: strings.TrimSpace(string(boot)), CoreSHA256: stockCoreSHA256, ProducerPID: os.Getpid(), ProducerStartTicks: producerTicks, ProducerSHA256: producerHash, ProducerUpstream: producerUpstream, ConsumedSHA256: hex.EncodeToString(consumedHash[:])}
+	o := newExecutionOwner(consumed, id, nil)
+	o.executable = coreFD
+	identityOwned = true
+	p.mu.Lock()
+	p.execution = o
+	p.apiPort = 0
+	p.mu.Unlock()
+	started := false
+	defer func() {
+		if err != nil {
+			o.invalidate("cold_start_failed")
+			_ = p.stop()
+			if !started {
+				o.closeIdentity("cold_start_failed")
+			}
+		}
+	}()
+	cmd := exec.CommandContext(context.Background(), "/proc/self/fd/4", "run", "-format", "json", "-c", "stdin:")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Pdeathsig: syscall.SIGKILL}
+	cmd.Stdin = configFD
+	cmd.ExtraFiles = []*os.File{configFD, coreFD}
+	cmd.Stdout = p.logWriter
+	cmd.Stderr = p.logWriter
+	if err = p.startCommand(cmd); err != nil {
+		return err
+	}
+	started = true
+	id.PID = cmd.Process.Pid
+	o.peerPID.Store(int64(id.PID))
+	id.StartTicks, err = procStartTicks(id.PID)
+	if err != nil {
+		return err
+	}
+	o.peerStartTicks.Store(id.StartTicks)
+	actualHash, err := hashFile(fmt.Sprintf("/proc/%d/exe", id.PID))
+	if err != nil || actualHash != stockCoreSHA256 {
+		return errors.New("executing core identity mismatch")
+	}
+	if err = verifySealedExecutable(fmt.Sprintf("/proc/%d/exe", id.PID), coreFD); err != nil {
+		return err
+	}
+	o.mu.Lock()
+	o.identity = id
+	o.checkIdentity = func() error {
+		if !p.IsRunning() {
+			return errors.New("core stopped")
+		}
+		ticks, e := procStartTicks(id.PID)
+		if e != nil || ticks != id.StartTicks {
+			return errors.New("core identity changed")
+		}
+		return verifySealedExecutable(fmt.Sprintf("/proc/%d/exe", id.PID), coreFD)
+	}
+	o.mu.Unlock()
+	api := &XrayAPI{}
+	if err = api.InitEndpoint(APIEndpoint{Network: "unix", Address: executionCorePath, owner: o}); err != nil {
+		return err
+	}
+	defer api.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	_, err = (*api.StatsServiceClient).GetSysStats(ctx, &statsService.SysStatsRequest{}, grpc.WaitForReady(true))
+	if err != nil {
+		return errors.New("native startup readiness unavailable")
+	}
