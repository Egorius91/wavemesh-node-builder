@@ -0,0 +1,26 @@
+package middleware
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/mhsanaei/3x-ui/v3/internal/config"
+)
+
+// An exact read allow-list, before all routes (including legacy and WebSocket
+// routes). Existing API authentication still protects the admitted reads.
+func WaveMeshMaintenance(basePath string) gin.HandlerFunc {
+	prefix := strings.TrimSuffix(basePath, "/") + "/panel/api/"
+	return func(c *gin.Context) {
+		if config.WaveMeshMaintenance() {
+			c.Header("X-WaveMesh-Panel-Mode", "maintenance-v1")
+			path := c.Request.URL.Path
+			if c.Request.Method != http.MethodGet || (path != prefix+"clients/list" && path != prefix+"wavemesh/maintenance") {
+				c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"success": false, "msg": "WAVEMESH_MAINTENANCE_READ_ONLY"})
+				return
+			}
+		}
+		c.Next()
+	}
+}
