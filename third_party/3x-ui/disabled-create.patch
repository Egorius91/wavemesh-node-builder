+
+func TestWaveMeshDisabledRouteRequiresAuthentication(t *testing.T) {
+	engine, apiController := newAPIAuthTestEngine(t)
+	// Mirror the production client group and auth/envelope/CSRF chain without
+	// constructing unrelated server controllers that start background jobs.
+	api := engine.Group("/panel/api")
+	api.Use(apiController.checkAPIAuth, middleware.ConfigEnvelopeMiddleware(), middleware.CSRFMiddleware())
+	NewClientController(api.Group("/clients"))
+	const token = "wavemesh-fixture-token-not-real"
+	if err := database.GetDB().Create(&model.ApiToken{Name: "fixture", Token: crypto.HashTokenSHA256(token), Enabled: true}).Error; err != nil { t.Fatal(err) }
+	ib := &model.Inbound{Tag: "wm-disabled", Enable: true, Port: 31401, Protocol: model.VLESS, Settings: `{"clients":[]}`}
+	if err := database.GetDB().Create(ib).Error; err != nil { t.Fatal(err) }
+	previous := runtime.GetManager()
+	calls := 0
+	runtime.SetManager(runtime.NewManager(runtime.LocalDeps{APIPort: func() int { calls++; return 0 }, SetNeedRestart: func() {}}))
+	t.Cleanup(func() { runtime.SetManager(previous) })
+	body, err := json.Marshal(service.ClientCreatePayload{Client: model.Client{Email: "wm-route@example.invalid", Enable: false}, InboundIds: []int{ib.Id}})
+	if err != nil { t.Fatal(err) }
+	for _, authed := range []bool{false, true} {
+		req := httptest.NewRequest(http.MethodPost, "/panel/api/clients/addDisabled", bytes.NewReader(body))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("X-Requested-With", "XMLHttpRequest")
+		if authed { req.Header.Set("Authorization", "Bearer "+token) }
+		w := httptest.NewRecorder()
+		engine.ServeHTTP(w, req)
+		if !authed {
+			if w.Code != http.StatusUnauthorized { t.Fatalf("unauthenticated status=%d", w.Code) }
+			var count int64
+			if err := database.GetDB().Model(&model.ClientRecord{}).Count(&count).Error; err != nil || count != 0 { t.Fatal("unauthenticated create changed DB") }
+			continue
+		}
+		var response struct { Success bool `json:"success"` }
+		if err := json.Unmarshal(w.Body.Bytes(), &response); err != nil || !response.Success || w.Code != http.StatusOK { t.Fatalf("route failed: status=%d body=%s", w.Code, w.Body.String()) }
+	}
+	rec, err := (&service.ClientService{}).GetRecordByEmail(nil, "wm-route@example.invalid")
+	if err != nil || rec.Enable || calls != 0 { t.Fatalf("route violated disabled contract: record=%v calls=%d err=%v", rec, calls, err) }
