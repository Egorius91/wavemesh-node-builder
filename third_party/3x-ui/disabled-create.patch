+func waveMeshRuntimeProbe(t *testing.T) *int {
+	t.Helper()
+	calls := new(int)
+	previous := runtime.GetManager()
+	runtime.SetManager(runtime.NewManager(runtime.LocalDeps{
+		APIPort: func() int { *calls++; return 0 },
+		SetNeedRestart: func() {},
+	}))
+	t.Cleanup(func() { runtime.SetManager(previous) })
+	return calls
+}
+
+func TestWaveMeshLegacyCreateDefaultsFalseToTrue(t *testing.T) {
+	setupBulkDB(t)
+	calls := waveMeshRuntimeProbe(t)
+	ib := mkInbound(t, 31201, model.VLESS, clientsSettings(t, nil))
+	svc, inboundSvc := &ClientService{}, &InboundService{}
+	_, err := svc.Create(inboundSvc, &ClientCreatePayload{
+		Client: model.Client{Email: "wm-legacy@example.invalid", Enable: false, ExpiryTime: 1},
