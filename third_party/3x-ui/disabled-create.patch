+func TestWaveMeshDisabledConcurrentCreateHasOneWinner(t *testing.T) {
+	setupBulkDB(t)
+	calls := waveMeshRuntimeProbe(t)
+	ib := mkInbound(t, 31511, model.VLESS, clientsSettings(t, nil))
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	for i := 0; i < 2; i++ {
+		go func() {
+			<-start
+			_, err := (&ClientService{}).CreateDisabled(&InboundService{}, &ClientCreatePayload{
+				Client: model.Client{Email: "wm-concurrent@example.invalid", ID: "33333333-3333-4333-8333-333333333333", SubID: "wm-concurrent", Enable: false}, InboundIds: []int{ib.Id},
+			})
+			results <- err
+		}()
+	}
+	close(start)
+	winners := 0
+	for i := 0; i < 2; i++ { if <-results == nil { winners++ } }
+	if winners != 1 { t.Fatalf("winner count=%d", winners) }
+	svc := &InboundService{}
+	got, err := svc.GetInbound(ib.Id)
+	if err != nil { t.Fatal(err) }
+	clients, err := svc.GetClients(got)
+	if err != nil || len(clients) != 1 || clients[0].Enable || *calls != 0 { t.Fatal("concurrent duplicate changed inbound or runtime") }
+}
