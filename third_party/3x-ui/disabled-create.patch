@@ -0,0 +1,31 @@
+package config
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+func TestWaveMeshStartupModeIsImmutable(t *testing.T) {
+	if os.Getenv("WM_MODE_CHILD") == "1" {
+		value := os.Getenv("WAVEMESH_PANEL_MODE")
+		invalid := value != "" && value != "maintenance"
+		if (ValidateWaveMeshMode() != nil) != invalid || WaveMeshMaintenance() != (value != "") {
+			t.Fatal("startup mode mismatch")
+		}
+		os.Setenv("WAVEMESH_PANEL_MODE", "")
+		if WaveMeshMaintenance() != (value != "") { t.Fatal("mode released by environment mutation") }
+		os.Setenv("WAVEMESH_PANEL_MODE", "maintenance")
+		if WaveMeshMaintenance() != (value != "") { t.Fatal("mode changed in running process") }
+		return
+	}
+	for _, value := range []string{"", "maintenance", "normal", "false", "MAINTENANCE", " maintenance"} {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestWaveMeshStartupModeIsImmutable$")
+		for _, entry := range os.Environ() {
+			if !strings.HasPrefix(entry, "WAVEMESH_PANEL_MODE=") && !strings.HasPrefix(entry, "WM_MODE_CHILD=") { cmd.Env = append(cmd.Env, entry) }
+		}
+		cmd.Env = append(cmd.Env, "WAVEMESH_PANEL_MODE="+value, "WM_MODE_CHILD=1")
+		if output, err := cmd.CombinedOutput(); err != nil { t.Fatalf("mode child failed: %s", output) }
+	}
+}
