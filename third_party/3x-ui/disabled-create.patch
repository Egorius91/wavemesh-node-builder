+package config
+
+import (
+	"errors"
+	"os"
+)
+
+// Capture only the process-start environment. Panel settings, .env reloads and
+// subsequent os.Setenv calls cannot release maintenance in this process.
+var waveMeshStartupMode = os.Getenv("WAVEMESH_PANEL_MODE")
+
+func WaveMeshMaintenance() bool { return waveMeshStartupMode != "" }
+
+func ValidateWaveMeshMode() error {
+	if waveMeshStartupMode != "" && waveMeshStartupMode != "maintenance" {
+		return errors.New("WAVEMESH_PANEL_MODE_INVALID")
+	}
+	return nil
+}
