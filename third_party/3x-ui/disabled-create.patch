+package middleware
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/mhsanaei/3x-ui/v3/internal/config"
+)
+
+func TestWaveMeshMaintenanceAdmitsOnlyAuthenticatedReadRoutes(t *testing.T) {
+	if !config.WaveMeshMaintenance() {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestWaveMeshMaintenanceAdmitsOnlyAuthenticatedReadRoutes$")
+		cmd.Env = append(os.Environ(), "WAVEMESH_PANEL_MODE=maintenance")
+		if output, err := cmd.CombinedOutput(); err != nil { t.Fatalf("maintenance child failed: %s", output) }
+		return
+	}
+	gin.SetMode(gin.TestMode)
+	for _, base := range []string{"/", "/private/"} {
+		engine := gin.New()
+		engine.Use(WaveMeshMaintenance(base))
+		called := false
+		engine.NoRoute(func(c *gin.Context) {
+			if c.GetHeader("Authorization") != "Bearer fixture" { c.AbortWithStatus(401); return }
+			called = true
+			c.Status(200)
+		})
+		for _, path := range []string{"panel/api/clients/list", "panel/api/wavemesh/maintenance", "panel/api/clients/list/", "panel/api/server/restartXray", "panel/api/setting/update", "ws", "login", "sub/test"} {
+			for _, method := range []string{"GET", "POST", "PUT", "HEAD", "OPTIONS"} {
+				for _, auth := range []bool{false, true} {
+					called = false
+					req := httptest.NewRequest(method, base+path, nil)
+					if auth { req.Header.Set("Authorization", "Bearer fixture") }
+					rr := httptest.NewRecorder(); engine.ServeHTTP(rr, req)
+					allowed := method == http.MethodGet && (path == "panel/api/clients/list" || path == "panel/api/wavemesh/maintenance")
+					want := 503; if allowed { want = 401; if auth { want = 200 } }
+					if rr.Code != want || called != (allowed && auth) { t.Fatalf("route escaped maintenance: %s %s code=%d", method, path, rr.Code) }
+				}
+			}
+		}
+	}
+}
