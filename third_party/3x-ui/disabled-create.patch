+func TestWaveMeshMaintenanceSkipsJobsAndSubscriptionListener(t *testing.T) {
+	if !config.WaveMeshMaintenance() {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestWaveMeshMaintenanceSkipsJobsAndSubscriptionListener$")
+		cmd.Env = append(os.Environ(), "WAVEMESH_PANEL_MODE=maintenance")
+		if output, err := cmd.CombinedOutput(); err != nil { t.Fatalf("maintenance child failed: %s", output) }
+		return
+	}
+	// No database or cron exists. Touching either before the maintenance gate
+	// would fail, rather than accidentally exercising a harmless empty config.
+	server := NewServer()
+	server.startTask(true)
+	if server.cron != nil { t.Fatal("maintenance scheduled background jobs") }
+	if err := sub.NewServer().Start(); err != nil { t.Fatal("maintenance opened subscription service") }
+	service := service.XrayService{}
+	if err := service.RestartXray(true); err == nil || err.Error() != "WAVEMESH_XRAY_MAINTENANCE" { t.Fatal("restart bypassed maintenance") }
+}
