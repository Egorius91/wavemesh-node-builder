+package xray
+
+import (
+	"os"
+	"os/exec"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/config"
+)
+
+func TestWaveMeshMaintenanceCannotLaunchNormalOrProbeXray(t *testing.T) {
+	if !config.WaveMeshMaintenance() {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestWaveMeshMaintenanceCannotLaunchNormalOrProbeXray$")
+		cmd.Env = append(os.Environ(), "WAVEMESH_PANEL_MODE=maintenance")
+		if output, err := cmd.CombinedOutput(); err != nil { t.Fatalf("maintenance child failed: %s", output) }
+		return
+	}
+	for _, p := range []*process{newProcess(nil), newTestProcess(nil, "must-not-be-written")} {
+		if err := p.Start(); err == nil || err.Error() != "WAVEMESH_XRAY_MAINTENANCE" { t.Fatal("Start bypassed maintenance") }
+		if err := p.startCommand(exec.Command("must-not-execute")); err == nil || err.Error() != "WAVEMESH_XRAY_MAINTENANCE" { t.Fatal("command bypassed maintenance") }
+		p.refreshVersion()
+		if p.IsRunning() || p.cmd != nil || p.version != "Unknown" { t.Fatal("process state changed") }
+	}
+}
