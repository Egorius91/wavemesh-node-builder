+// WaveMesh modification, 2026-09-14. SPDX-License-Identifier: GPL-3.0-only
+package service
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/web/runtime"
+)
+
+func waveMeshRuntimeProbe(t *testing.T) *int {
+	t.Helper()
+	calls := new(int)
+	previous := runtime.GetManager()
+	runtime.SetManager(runtime.NewManager(runtime.LocalDeps{
+		APIPort: func() int { *calls++; return 0 },
+		SetNeedRestart: func() {},
+	}))
+	t.Cleanup(func() { runtime.SetManager(previous) })
+	return calls
+}
+
+func TestWaveMeshLegacyCreateDefaultsFalseToTrue(t *testing.T) {
+	setupBulkDB(t)
+	calls := waveMeshRuntimeProbe(t)
+	ib := mkInbound(t, 31201, model.VLESS, clientsSettings(t, nil))
+	svc, inboundSvc := &ClientService{}, &InboundService{}
+	_, err := svc.Create(inboundSvc, &ClientCreatePayload{
+		Client: model.Client{Email: "wm-legacy@example.invalid", Enable: false, ExpiryTime: 1},
+		InboundIds: []int{ib.Id},
+	})
+	if err != nil { t.Fatal(err) }
+	rec, err := svc.GetRecordByEmail(nil, "wm-legacy@example.invalid")
+	if err != nil || !rec.Enable || *calls != 1 {
+		t.Fatalf("legacy endpoint contract changed: enabled=%v calls=%d err=%v", rec, *calls, err)
+	}
+}
+
+func TestWaveMeshDisabledCreatePersistsFalseWithoutRuntimeAdd(t *testing.T) {
+	for _, count := range []int{1, 2} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			setupBulkDB(t)
+			calls := waveMeshRuntimeProbe(t)
+			svc, inboundSvc := &ClientService{}, &InboundService{}
+			ids := []int{}
+			for i := 0; i < count; i++ {
+				ib := mkInbound(t, 31210+i, model.VLESS, clientsSettings(t, nil))
+				ids = append(ids, ib.Id)
+			}
+			payload := &ClientCreatePayload{Client: model.Client{
+				Email: "wm-disabled@example.invalid", ID: "11111111-1111-4111-8111-111111111111",
+				SubID: "wm-disabled-fixture", Enable: false, ExpiryTime: 4102444800000,
+			}, InboundIds: ids}
+			restart, err := svc.CreateDisabled(inboundSvc, payload)
+			if err != nil || restart || *calls != 0 {
+				t.Fatalf("disabled create: restart=%v runtime calls=%d err=%v", restart, *calls, err)
+			}
+			rec, err := svc.GetRecordByEmail(nil, payload.Client.Email)
+			if err != nil || rec.Enable || rec.UUID != payload.Client.ID {
+				t.Fatalf("disabled record not preserved: record=%v err=%v", rec, err)
+			}
+			for _, id := range ids {
+				ib, err := inboundSvc.GetInbound(id)
+				if err != nil { t.Fatal(err) }
+				clients, err := inboundSvc.GetClients(ib)
+				if err != nil || len(clients) != 1 || clients[0].Enable {
+					t.Fatalf("inbound not disabled: clients=%v err=%v", clients, err)
+				}
+			}
+		})
+	}
+}
+
+func TestWaveMeshDisabledCreateRejectsTargetsBeforeWriting(t *testing.T) {
+	for _, kind := range []string{"enabled", "missing", "non-vless", "remote"} {
+		t.Run(kind, func(t *testing.T) {
+			setupBulkDB(t)
+			calls := waveMeshRuntimeProbe(t)
+			svc, inboundSvc := &ClientService{}, &InboundService{}
+			ib := mkInbound(t, 31301, model.VLESS, clientsSettings(t, nil))
+			payload := &ClientCreatePayload{Client: model.Client{Email: "wm-invalid@example.invalid"}, InboundIds: []int{ib.Id}}
+			switch kind {
+			case "enabled": payload.Client.Enable = true
+			case "missing": payload.InboundIds = append(payload.InboundIds, 2147483647)
+			case "non-vless":
+				other := mkInbound(t, 31302, model.VMESS, clientsSettings(t, nil))
+				payload.InboundIds = append(payload.InboundIds, other.Id)
+			case "remote":
+				nodeID, _ := setupNodeRuntime(t)
+				other := nodeInbound(t, nodeID, 31303, nil)
+				payload.InboundIds = append(payload.InboundIds, other.Id)
+			}
+			if _, err := svc.CreateDisabled(inboundSvc, payload); err == nil { t.Fatal("accepted unsafe input") }
+			var count int64
+			if err := database.GetDB().Model(&model.ClientRecord{}).Count(&count).Error; err != nil || count != 0 || *calls != 0 {
+				t.Fatalf("rejected create mutated state: count=%d calls=%d err=%v", count, *calls, err)
+			}
+		})
+	}
+}
+
+func TestWaveMeshDisabledInsertFailureRollsBackInsteadOfKeepingDefaultTrue(t *testing.T) {
+	setupBulkDB(t)
+	calls := waveMeshRuntimeProbe(t)
+	ib := mkInbound(t, 31501, model.VLESS, clientsSettings(t, nil))
+	if err := database.GetDB().Exec(`CREATE TRIGGER wm_reject_disable BEFORE UPDATE OF enable ON clients WHEN NEW.enable = 0 BEGIN SELECT RAISE(ABORT, 'synthetic disable failure'); END`).Error; err != nil { t.Fatal(err) }
+	_, err := (&ClientService{}).CreateDisabled(&InboundService{}, &ClientCreatePayload{
+		Client: model.Client{Email: "wm-rollback@example.invalid", Enable: false}, InboundIds: []int{ib.Id},
+	})
+	if err == nil { t.Fatal("expected injected failure") }
+	var count int64
+	if err := database.GetDB().Model(&model.ClientRecord{}).Count(&count).Error; err != nil || count != 0 || *calls != 0 {
+		t.Fatalf("failed insert leaked enabled state: count=%d calls=%d err=%v", count, *calls, err)
+	}
+}
