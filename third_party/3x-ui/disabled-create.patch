+	return s.create(inboundSvc, payload, false)
+}
+
+// CreateDisabled is the WaveMesh local VLESS preparation contract. Unlike
+// Create, it never defaults false to true. Validate every target before the
+// first write; remote-panel propagation is deliberately outside this contract.
+func (s *ClientService) CreateDisabled(inboundSvc *InboundService, payload *ClientCreatePayload) (bool, error) {
+	if payload == nil || payload.Client.Enable || len(payload.InboundIds) == 0 {
+		return false, common.NewError("disabled client and local VLESS targets required")
+	}
+	for _, id := range payload.InboundIds {
+		inbound, err := inboundSvc.GetInbound(id)
+		if err != nil {
+			return false, err
+		}
+		if inbound.NodeID != nil || inbound.Protocol != model.VLESS {
+			return false, common.NewError("disabled creation supports only local VLESS targets")
+		}
+	}
+	return s.create(inboundSvc, payload, true)
+}
